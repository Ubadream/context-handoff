diff --git a/codex-rs/exec-server/src/no_follow/atomic_directory_windows.rs b/codex-rs/exec-server/src/no_follow/atomic_directory_windows.rs
new file mode 100644
index 000000000..f9de3ff16
--- /dev/null
+++ b/codex-rs/exec-server/src/no_follow/atomic_directory_windows.rs
@@ -0,0 +1,228 @@
+// Copyright 2026 Ubadream
+// SPDX-License-Identifier: Apache-2.0
+//! Atomic index replacement anchored to a held Windows directory handle.
+//!
+//! The directory is opened once with `OBJ_DONT_REPARSE`, so no component of its
+//! path may be a symlink, junction or other reparse point. Every later open and
+//! the final rename are relative to that held handle; no path string is resolved
+//! again. Replacement uses `FileRenameInfoEx` with POSIX semantics, which swaps
+//! the directory entry without opening or truncating the existing target.
+
+use super::super::AtomicPublication;
+use super::FILE_CREATE;
+use super::FILE_NON_DIRECTORY_FILE;
+use super::FILE_OPEN;
+use super::open_directory_by_components;
+use super::open_handle_at;
+use super::validate_regular_file;
+use std::ffi::OsStr;
+use std::io;
+use std::io::Read;
+use std::io::Write;
+use std::mem::size_of;
+use std::os::windows::ffi::OsStrExt;
+use std::os::windows::io::AsRawHandle;
+use std::os::windows::io::OwnedHandle;
+use std::path::Path;
+use windows_sys::Win32::Foundation::HANDLE;
+use windows_sys::Win32::Foundation::NTSTATUS;
+use windows_sys::Win32::Foundation::RtlNtStatusToDosError;
+use windows_sys::Win32::Storage::FileSystem::DELETE;
+use windows_sys::Win32::Storage::FileSystem::FILE_ADD_FILE;
+use windows_sys::Win32::Storage::FileSystem::FILE_GENERIC_READ;
+use windows_sys::Win32::Storage::FileSystem::FILE_LIST_DIRECTORY;
+use windows_sys::Win32::Storage::FileSystem::FILE_READ_ATTRIBUTES;
+use windows_sys::Win32::Storage::FileSystem::FILE_RENAME_INFO;
+use windows_sys::Win32::Storage::FileSystem::FILE_TRAVERSE;
+use windows_sys::Win32::Storage::FileSystem::FILE_WRITE_DATA;
+use windows_sys::Win32::Storage::FileSystem::FlushFileBuffers;
+use windows_sys::Win32::System::IO::IO_STATUS_BLOCK;
+use windows_sys::Win32::System::IO::IO_STATUS_BLOCK_0;
+
+// Not exported by windows-sys 0.52; values from ntifs.h / winbase.h.
+// kernel32's SetFileInformationByHandle rejects a non-null RootDirectory with
+// ERROR_INVALID_PARAMETER, so the handle-relative rename goes through ntdll.
+const FILE_RENAME_INFORMATION_EX: i32 = 65;
+const FILE_RENAME_FLAG_REPLACE_IF_EXISTS: u32 = 0x0000_0001;
+const FILE_RENAME_FLAG_POSIX_SEMANTICS: u32 = 0x0000_0002;
+
+#[link(name = "ntdll")]
+unsafe extern "system" {
+    fn NtSetInformationFile(
+        file_handle: HANDLE,
+        io_status_block: *mut IO_STATUS_BLOCK,
+        file_information: *const std::ffi::c_void,
+        length: u32,
+        file_information_class: i32,
+    ) -> NTSTATUS;
+}
+
+#[derive(Debug)]
+pub(crate) struct Directory {
+    handle: OwnedHandle,
+}
+
+impl Directory {
+    pub(crate) fn open(path: &Path) -> io::Result<Self> {
+        // FILE_ADD_FILE (write access) also lets FlushFileBuffers sync the directory.
+        let handle = open_directory_by_components(
+            path,
+            FILE_LIST_DIRECTORY | FILE_TRAVERSE | FILE_ADD_FILE | FILE_READ_ATTRIBUTES,
+        )?;
+        Ok(Self { handle })
+    }
+
+    fn raw(&self) -> HANDLE {
+        self.handle.as_raw_handle() as HANDLE
+    }
+
+    fn create_new_with(&self, leaf: &str, extra_access: u32) -> io::Result<std::fs::File> {
+        validate_leaf(leaf)?;
+        let handle = open_handle_at(
+            self.raw(),
+            &wide(leaf),
+            FILE_READ_ATTRIBUTES | FILE_WRITE_DATA | extra_access,
+            FILE_CREATE,
+            FILE_NON_DIRECTORY_FILE,
+        )?;
+        let file = std::fs::File::from(handle);
+        validate_regular_file(&file, Path::new(leaf))?;
+        Ok(file)
+    }
+
+    pub(crate) fn create_new(&self, leaf: &str) -> io::Result<std::fs::File> {
+        self.create_new_with(leaf, 0)
+    }
+
+    pub(crate) fn read_bounded(&self, leaf: &str, max_bytes: u64) -> io::Result<String> {
+        validate_leaf(leaf)?;
+        let limit = max_bytes.checked_add(1).ok_or_else(|| {
+            io::Error::new(io::ErrorKind::InvalidInput, "file byte limit overflow")
+        })?;
+        let handle = open_handle_at(
+            self.raw(),
+            &wide(leaf),
+            FILE_GENERIC_READ,
+            FILE_OPEN,
+            FILE_NON_DIRECTORY_FILE,
+        )?;
+        let file = std::fs::File::from(handle);
+        validate_regular_file(&file, Path::new(leaf))?;
+        let mut bytes = Vec::new();
+        file.take(limit).read_to_end(&mut bytes)?;
+        if bytes.len() as u64 > max_bytes {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "file exceeds byte limit",
+            ));
+        }
+        String::from_utf8(bytes).map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))
+    }
+
+    pub(crate) fn sync(&self) -> io::Result<()> {
+        if unsafe { FlushFileBuffers(self.raw()) } == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(())
+    }
+
+    pub(crate) fn publish(&self, leaf: &str, content: &[u8]) -> io::Result<AtomicPublication> {
+        self.publish_with_checks(leaf, content, || Ok(()), || self.sync())
+    }
+
+    fn publish_with_checks(
+        &self,
+        leaf: &str,
+        content: &[u8],
+        before_replace: impl FnOnce() -> io::Result<()>,
+        sync_after_replace: impl FnOnce() -> io::Result<()>,
+    ) -> io::Result<AtomicPublication> {
+        validate_leaf(leaf)?;
+        let pending = format!(".pending-{}.json", uuid::Uuid::new_v4());
+        let mut file = self.create_new_with(&pending, DELETE)?;
+        file.write_all(content)?;
+        file.sync_all()?;
+        before_replace()?;
+        // The new name is relative to the same held directory handle; the existing
+        // destination entry is replaced, never opened or truncated.
+        rename_within(&file, self.raw(), leaf)?;
+        drop(file);
+        match sync_after_replace() {
+            Ok(()) => Ok(AtomicPublication::Durable),
+            Err(error) => Ok(AtomicPublication::VisibleButDurabilityUnconfirmed(error)),
+        }
+        // Failures before rename intentionally retain an unreferenced temporary
+        // file. No racy path-based cleanup is performed here.
+    }
+}
+
+fn wide(leaf: &str) -> Vec<u16> {
+    OsStr::new(leaf).encode_wide().collect()
+}
+
+fn rename_within(file: &std::fs::File, directory: HANDLE, leaf: &str) -> io::Result<()> {
+    let name = wide(leaf);
+    let name_bytes = name.len() * size_of::<u16>();
+    // FILE_RENAME_INFO ends in a one-element name array; allocate room for the
+    // whole name with u64 alignment, which covers the struct's alignment.
+    let total = size_of::<FILE_RENAME_INFO>() + name_bytes;
+    let mut buffer = vec![0u64; total.div_ceil(size_of::<u64>())];
+    let info = buffer.as_mut_ptr().cast::<FILE_RENAME_INFO>();
+    let length = u32::try_from(name_bytes).map_err(|_| {
+        io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "storage entry name is too long",
+        )
+    })?;
+    unsafe {
+        (*info).Anonymous.Flags =
+            FILE_RENAME_FLAG_REPLACE_IF_EXISTS | FILE_RENAME_FLAG_POSIX_SEMANTICS;
+        (*info).RootDirectory = directory;
+        (*info).FileNameLength = length;
+        std::ptr::copy_nonoverlapping(
+            name.as_ptr(),
+            (&raw mut (*info).FileName).cast::<u16>(),
+            name.len(),
+        );
+    }
+    let mut io_status_block = IO_STATUS_BLOCK {
+        Anonymous: IO_STATUS_BLOCK_0 { Status: 0 },
+        Information: 0,
+    };
+    let status = unsafe {
+        NtSetInformationFile(
+            file.as_raw_handle() as HANDLE,
+            &mut io_status_block,
+            info.cast(),
+            u32::try_from(total).map_err(|_| io::Error::other("rename buffer is too large"))?,
+            FILE_RENAME_INFORMATION_EX,
+        )
+    };
+    if status < 0 {
+        let code = unsafe { RtlNtStatusToDosError(status) };
+        return Err(io::Error::from_raw_os_error(code as i32));
+    }
+    Ok(())
+}
+
+fn validate_leaf(leaf: &str) -> io::Result<()> {
+    if leaf.is_empty()
+        || leaf == "."
+        || leaf == ".."
+        || leaf.contains(['/', '\\', ':', '\0', '<', '>', '"', '|', '?', '*'])
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "expected a single storage entry name",
+        ));
+    }
+    Ok(())
+}
