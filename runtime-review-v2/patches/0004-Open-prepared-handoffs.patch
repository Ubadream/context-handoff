+fn is_local_disk_path(path: &Path) -> bool {
+    matches!(
+        path.components().next(),
+        Some(Component::Prefix(prefix))
+            if matches!(prefix.kind(), Prefix::Disk(_) | Prefix::VerbatimDisk(_))
+    )
+}
+
+/// Opens a directory one component at a time. Only the volume root is resolved
+/// by name, because the `\??\X:` drive name is itself an object-manager link that
+/// `OBJ_DONT_REPARSE` refuses. Every directory below it is opened relative to the
+/// previous handle with `OBJ_DONT_REPARSE`, so no component can be a reparse point.
+fn open_directory_by_components(path: &Path, final_access: u32) -> io::Result<OwnedHandle> {
+    if !is_local_disk_path(path) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "held-directory storage requires a local disk path",
+        ));
+    }
+    let nt = nt_path(path)?;
+    let nt = &nt[..nt.len() - 1];
+    let mut components = path.components();
+    let Some(Component::Prefix(_)) = components.next() else {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "expected an absolute Windows path",
+        ));
+    };
+    if !matches!(components.next(), Some(Component::RootDir)) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "expected an absolute Windows path",
+        ));
+    }
+    let names: Vec<&OsStr> = components
+        .map(|component| match component {
+            Component::Normal(name) => Ok(name),
+            _ => Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "path must not contain . or ..",
+            )),
+        })
+        .collect::<io::Result<_>>()?;
+    // The NT root (for example `\??\C:\`) is the NT path without the remaining
+    // components and the separators between them.
+    let tail: usize = names
+        .iter()
+        .map(|name| name.encode_wide().count() + 1)
+        .sum::<usize>()
+        .saturating_sub(1);
+    let root_len = nt.len().checked_sub(tail).ok_or_else(|| {
+        io::Error::new(io::ErrorKind::InvalidInput, "unexpected Windows path shape")
+    })?;
+    let root_access = if names.is_empty() {
+        final_access
+    } else {
+        FILE_TRAVERSE
+    };
+    let mut handle = open_handle_with(
+        0,
+        &nt[..root_len],
+        root_access,
+        FILE_OPEN,
+        FILE_DIRECTORY_FILE,
+        /*reparse_attribute*/ 0,
+    )?;
+    for (index, name) in names.iter().enumerate() {
+        let access = if index + 1 == names.len() {
+            final_access
+        } else {
+            FILE_TRAVERSE
+        };
+        let wide: Vec<u16> = name.encode_wide().collect();
+        handle = open_handle_at(
+            handle.as_raw_handle() as HANDLE,
+            &wide,
+            access,
+            FILE_OPEN,
+            FILE_DIRECTORY_FILE,
+        )?;
+    }
+    Ok(handle)
+}
