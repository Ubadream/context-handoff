+/// Opens `name` relative to `root` (or as a full NT path when `root` is 0).
+/// `OBJ_DONT_REPARSE` rejects any reparse point while resolving the name.
+fn open_handle_at(
+    root: HANDLE,
+    name: &[u16],
+    desired_access: u32,
+    create_disposition: u32,
+    create_options: u32,
+) -> io::Result<OwnedHandle> {
+    open_handle_with(
+        root,
+        name,
+        desired_access,
+        create_disposition,
+        create_options,
+        OBJ_DONT_REPARSE as u32,
+    )
+}
