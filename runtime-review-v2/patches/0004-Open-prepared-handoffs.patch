+//! Windows-only behavior of the held-handle store: reparse points in the path are
+//! rejected, and replacement works while a reader still has the old entry open.
+
+use super::AtomicPublication;
+use super::Directory;
+use pretty_assertions::assert_eq;
+use std::io;
+use std::io::Read;
+use std::process::Command;
+
+#[test]
+fn atomic_store_rejects_a_junction_anywhere_in_the_directory_path() -> io::Result<()> {
+    let temp = tempfile::tempdir()?;
+    let root = temp.path().canonicalize()?;
+    let real = root.join("real");
+    std::fs::create_dir(&real)?;
+    let junction = root.join("junction");
+    // Junctions need no special privilege, unlike symlinks.
+    let status = Command::new("cmd")
+        .args(["/C", "mklink", "/J"])
+        .arg(&junction)
+        .arg(&real)
+        .status()?;
+    assert!(status.success(), "mklink /J failed");
+    assert!(Directory::open(&junction).is_err());
+    let nested = junction.join("child");
+    std::fs::create_dir(real.join("child"))?;
+    assert!(Directory::open(&nested).is_err());
+    assert!(Directory::open(&real.join("child")).is_ok());
+    Ok(())
+}
+
+#[test]
+fn atomic_store_replaces_binding_while_old_entry_is_open() -> io::Result<()> {
+    let temp = tempfile::tempdir()?;
+    let root = temp.path().canonicalize()?;
+    std::fs::write(root.join("binding.json"), "old binding")?;
+    let directory = Directory::open(&root)?;
+    let mut reader = std::fs::File::open(root.join("binding.json"))?;
+    let result = directory.publish("binding.json", b"new binding")?;
+    assert!(matches!(
+        result,
+        AtomicPublication::Durable | AtomicPublication::VisibleButDurabilityUnconfirmed(_)
+    ));
+    let mut old = String::new();
+    reader.read_to_string(&mut old)?;
+    assert_eq!(old, "old binding");
+    assert_eq!(directory.read_bounded("binding.json", 1024)?, "new binding");
+    assert_eq!(std::fs::read_dir(&root)?.count(), 1);
+    Ok(())
+}
+
+#[test]
+fn atomic_store_create_new_refuses_existing_entries() -> io::Result<()> {
+    let temp = tempfile::tempdir()?;
+    let root = temp.path().canonicalize()?;
+    std::fs::write(root.join("taken.md"), "keep")?;
+    let directory = Directory::open(&root)?;
+    assert!(directory.create_new("taken.md").is_err());
+    assert_eq!(std::fs::read_to_string(root.join("taken.md"))?, "keep");
+    Ok(())
+}
