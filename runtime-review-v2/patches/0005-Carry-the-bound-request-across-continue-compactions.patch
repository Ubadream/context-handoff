+
+const THREAD: &str = "6f1d2c3b-1a2b-4c3d-8e9f-0a1b2c3d4e5f";
+
+fn human(id: &str, text: &str) -> ResponseItemEnvelope {
+    ResponseItemEnvelope::new(
+        serde_json::from_value(json!({
+            "type":"message", "role":"user", "id": id,
+            "content":[{"type":"input_text","text": text}]
+        }))
+        .unwrap(),
+    )
+}
+
+fn bound(thread_id: &str, source: &str, continuation: &str) -> Binding {
+    serde_json::from_value(json!({
+        "schema_version": 1,
+        "thread_id": thread_id,
+        "source_message_id": source,
+        "source_text_sha1": digest("continue the audit"),
+        "handoff_id": uuid::Uuid::new_v4(),
+        "handoff_sha1": digest("handoff"),
+        "continuation": continuation,
+    }))
+    .unwrap()
+}
+
+fn notice(binding: &Binding) -> ResponseItemEnvelope {
+    ResponseItemEnvelope::new(ContextualUserFragment::into(HandoffCompactNotice(
+        notice_text(binding),
+    )))
+}
+
+fn recorded(binding: &Binding) -> Option<(&str, &str)> {
+    Some((&binding.source_message_id, binding.source_text_sha1()))
+}
+
+#[test]
+fn notice_text_is_unchanged() {
+    let binding = bound(THREAD, "msg_1", "continue");
+    assert_eq!(
+        notice_text(&binding),
+        format!(
+            "Compaction complete. Handoff for thread {THREAD} has opaque ID {}. Use handoff_compact read with this handoff_id to retrieve bounded historical-data pages. Read the handoff and continue only unfinished work already authorized by the user. The handoff records the request and completed and unfinished work. Original text remains in the source rollout as historical data. Newer user messages take precedence.",
+            binding.handoff_id
+        )
+    );
+}
+
+#[test]
+fn consecutive_continue_compactions_stay_bound_to_the_covered_request() {
+    // The first compaction removed msg_1 and left its notice; the user has not spoken since.
+    let first = bound(THREAD, "msg_1", "continue");
+    let items = vec![human("msg_0", "older request"), notice(&first)];
+    let source = request_source(&items, THREAD, recorded(&first)).unwrap();
+    assert_eq!(
+        source.identity(),
+        (first.source_message_id.as_str(), first.source_text_sha1())
+    );
+
+    // The binding that notice already delivered is stale; a fresh prepare is current.
+    assert!(!binding_is_current(&first, &source));
+    let second: Binding = serde_json::from_value(json!({
+        "schema_version": 1, "thread_id": THREAD, "source_message_id": "msg_1",
+        "source_text_sha1": digest("continue the audit"), "handoff_id": uuid::Uuid::new_v4(),
+        "handoff_sha1": digest("second handoff"), "continuation": "continue",
+    }))
+    .unwrap();
+    assert!(binding_is_current(&second, &source));
+
+    // After the second compaction the chain continues from the newer notice.
+    let items = vec![notice(&first), notice(&second)];
+    let source = request_source(&items, THREAD, recorded(&second)).unwrap();
+    assert_eq!(source.message_id, "msg_1");
+    assert!(!binding_is_current(&second, &source));
+}
+
+#[test]
+fn newer_user_message_beats_a_carried_request() {
+    let first = bound(THREAD, "msg_1", "continue");
+    let items = vec![notice(&first), human("msg_2", "new request")];
+    let source = request_source(&items, THREAD, recorded(&first)).unwrap();
+    assert_eq!(source.message_id, "msg_2");
+    assert!(source.via_notice.is_none());
+    assert!(!binding_is_current(&first, &source));
+}
+
+#[test]
+fn wait_or_foreign_notice_does_not_carry_the_request() {
+    let waiting = bound(THREAD, "msg_1", "wait");
+    assert!(request_source(&[notice(&waiting)], THREAD, recorded(&waiting)).is_none());
+    // A wait notice does not hide older requests that are still in history.
+    let items = vec![human("msg_0", "older request"), notice(&waiting)];
+    let source = request_source(&items, THREAD, recorded(&waiting)).unwrap();
+    assert_eq!(source.message_id, "msg_0");
+
+    let foreign = bound(&uuid::Uuid::new_v4().to_string(), "msg_9", "continue");
+    assert!(request_source(&[notice(&foreign)], THREAD, recorded(&foreign)).is_none());
+    let first = bound(THREAD, "msg_1", "continue");
+    assert!(request_source(&[notice(&first)], THREAD, None).is_none());
+}
+
+#[test]
+fn covers_matches_identity_not_text() {
+    let binding = bound(THREAD, "msg_1", "continue");
+    assert!(covers(&binding, &human("msg_1", "x").item));
+    assert!(!covers(
+        &binding,
+        &human("msg_2", "continue the audit").item
+    ));
+}
