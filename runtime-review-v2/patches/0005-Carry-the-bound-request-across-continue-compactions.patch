+const CONTINUE_NEXT: &str =
+    "Read the handoff and continue only unfinished work already authorized by the user.";
+const WAIT_NEXT: &str = "Read the handoff to confirm the stopping point. Work is complete or awaiting the user decision; do not start new work.";
+
+fn notice_prefix(thread_id: &str) -> String {
+    format!("Compaction complete. Handoff for thread {thread_id} has opaque ID ")
+}
+
+fn notice_text(binding: &Binding) -> String {
+    let next = match binding.continuation {
+        Continuation::Continue => CONTINUE_NEXT,
+        Continuation::Wait => WAIT_NEXT,
+    };
+    format!(
+        "{}{}. Use handoff_compact read with this handoff_id to retrieve bounded historical-data pages. {next} The handoff records the request and completed and unfinished work. Original text remains in the source rollout as historical data. Newer user messages take precedence.",
+        notice_prefix(&binding.thread_id),
+        binding.handoff_id,
+    )
+}
+
+/// Text of this thread's bound-compaction notice, if `item` is one.
+fn bound_notice(item: &ResponseItem, thread_id: &str) -> Option<String> {
+    let ResponseItem::Message { role, content, .. } = item else {
+        return None;
+    };
+    if role != "user" {
+        return None;
+    }
+    let prefix = notice_prefix(thread_id);
+    content.iter().find_map(|part| match part {
+        ContentItem::InputText { text }
+            if HandoffCompactNotice::matches_text(text) && text.contains(&prefix) =>
+        {
+            Some(text.clone())
+        }
+        _ => None,
     })
 }
 
+struct RequestSource {
+    message_id: String,
+    text_sha1: String,
+    /// Set when the request was carried over a bound `continue` compaction.
+    via_notice: Option<String>,
+}
+
+impl RequestSource {
+    fn identity(&self) -> (&str, &str) {
+        (&self.message_id, &self.text_sha1)
+    }
+}
+
+/// The newest user request. A bound `continue` compaction removes the request it
+/// covered; until the user speaks again, the request recorded in the binding keeps
+/// standing, so consecutive agent-scheduled compactions stay bound to it.
+fn request_source(
+    items: &[ResponseItemEnvelope],
+    thread_id: &str,
+    recorded: Option<(&str, &str)>,
+) -> Option<RequestSource> {
+    for envelope in items.iter().rev() {
+        let item = &envelope.item;
+        if let Some(text) = request_text(item) {
+            if let Some(id) = item.id() {
+                return Some(RequestSource {
+                    message_id: id.to_string(),
+                    text_sha1: digest(&text),
+                    via_notice: None,
+                });
+            }
+            continue;
+        }
+        if let Some((message_id, text_sha1)) = recorded
+            && let Some(notice) = bound_notice(item, thread_id)
+            && notice.contains(CONTINUE_NEXT)
+        {
+            return Some(RequestSource {
+                message_id: message_id.to_string(),
+                text_sha1: text_sha1.to_string(),
+                via_notice: Some(notice),
+            });
+        }
+    }
+    None
+}
+
+/// Whether `binding` is the one to deliver for `source`: it covers that request and
+/// was not already delivered by the compaction that carried it over.
+fn binding_is_current(binding: &Binding, source: &RequestSource) -> bool {
+    source.identity()
+        == (
+            binding.source_message_id.as_str(),
+            binding.source_text_sha1(),
+        )
+        && !source
+            .via_notice
+            .as_ref()
+            .is_some_and(|notice| notice.contains(&binding.handoff_id.to_string()))
+}
+
+/// Whether `item` is the request `binding` covers.
+pub(crate) fn covers(binding: &Binding, item: &ResponseItem) -> bool {
+    item.id()
+        .is_some_and(|id| id.to_string() == binding.source_message_id)
+}
+
+async fn recorded_binding(sess: &Session, turn: &TurnContext) -> Option<Binding> {
+    // An unreadable record only loses the carry-over; prepare replaces it and load
+    // reports the error through binding_for_request.
+    let store = open_store(sess, turn).ok().flatten()?;
+    tokio::task::spawn_blocking(move || store.current_binding())
+        .await
+        .ok()?
+        .ok()
+        .flatten()
+}
+
+async fn last_request(sess: &Session, recorded: Option<&Binding>) -> Option<RequestSource> {
+    let history = sess.clone_history().await;
+    request_source(
+        history.annotated_items(),
+        &sess.thread_id.to_string(),
+        recorded.map(|b| (b.source_message_id.as_str(), b.source_text_sha1())),
+    )
+}
