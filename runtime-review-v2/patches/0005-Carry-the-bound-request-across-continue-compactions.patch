+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[cfg_attr(
+    not(any(unix, windows)),
+    ignore = "prepared handoffs need the atomic no-follow store"
+)]
+async fn handoff_compact_second_continue_binds_without_new_message() -> Result<()> {
+    let dir = tempfile::tempdir()?;
+    let first = dir.path().join("HANDOFF.md");
+    let second = dir.path().join("HANDOFF2.md");
+    std::fs::write(
+        &first,
+        "Synthetic request: audit everything. Completed: first half. Next: second half.",
+    )?;
+    std::fs::write(
+        &second,
+        "Synthetic request: audit everything. Completed: second half. Next: wrap up.",
+    )?;
+    let prepare_again = sse(vec![
+        ev_function_call(
+            "prepare2",
+            "handoff_compact",
+            &json!({
+                "mode": "prepare", "reason": "second stopping point",
+                "handoff_path": second, "continuation": "continue",
+            })
+            .to_string(),
+        ),
+        ev_completed("prepare2"),
+    ]);
+    let server = responses::start_mock_server().await;
+    let mock = responses::mount_sse_sequence(
+        &server,
+        vec![
+            prepare(&first, "continue"),
+            select("select", "A"),
+            reply("final", "first half saved"),
+            reply("summary", "FIRST_SUMMARY"),
+            prepare_again,
+            select("select2", "A"),
+            reply("final2", "second half saved"),
+            reply("summary2", "SECOND_SUMMARY"),
+            reply("continued", "wrapping up"),
+        ],
+    )
+    .await;
+    let test = test_codex()
+        .with_config(|c| c.model_provider.name = "OpenAI (test)".to_string())
+        .build(&server)
+        .await?;
+    test.submit_turn("OLD_REQUEST_CARRIED_TWICE").await?;
+    let requests = mock.requests();
+    assert_eq!(
+        requests.len(),
+        9,
+        "both compactions continue without a new prompt"
+    );
+    let prepared = requests[5]
+        .function_call_output_text("prepare2")
+        .unwrap_or_default();
+    assert!(
+        !prepared.contains("No current user request can be bound"),
+        "{prepared}"
+    );
+    let entry = std::fs::read_dir(test.codex_home_path().join("handoff-compact/handoffs"))?
+        .next()
+        .unwrap()?;
+    let binding: serde_json::Value =
+        serde_json::from_str(&std::fs::read_to_string(entry.path().join("binding.json"))?)?;
+    let handoff_id = binding["handoff_id"].as_str().unwrap();
+    assert_eq!(
+        std::fs::read_to_string(entry.path().join(format!("{handoff_id}.md")))?,
+        std::fs::read_to_string(&second)?
+    );
+    assert!(requests[8].body_contains_text("SECOND_SUMMARY"));
+    assert!(requests[8].body_contains_text(handoff_id));
+    assert!(!requests[8].body_contains_text("OLD_REQUEST_CARRIED_TWICE"));
+    Ok(())
+}
