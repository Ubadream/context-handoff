new file mode 100644
index 0000000000000000000000000000000000000000..8170f6a0cd753edd562c4a3246ab90ac8a916edb
--- /dev/null
+++ b/codex-rs/exec-server/src/no_follow/atomic_directory_unix.rs
@@ -0,0 +1,128 @@
+// Copyright 2026 Ubadream
+// SPDX-License-Identifier: Apache-2.0
+//! Atomic index replacement anchored to a held Unix directory descriptor.
+
+use super::super::AtomicPublication;
+use super::parent;
+use rustix::fs::Mode;
+use rustix::fs::OFlags;
+use rustix::fs::fsync;
+use rustix::fs::openat;
+use rustix::fs::renameat;
+use std::io;
+use std::io::Read;
+use std::io::Write;
+use std::os::fd::OwnedFd;
+use std::path::Path;
+
+#[derive(Debug)]
+pub(crate) struct Directory {
+    parent: OwnedFd,
+}
+
+impl Directory {
+    pub(crate) fn open(path: &Path) -> io::Result<Self> {
+        let (parent, leaf) = parent(path)?;
+        let parent = openat(
+            &parent,
+            leaf,
+            OFlags::RDONLY | OFlags::DIRECTORY | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+            Mode::empty(),
+        )
+        .map_err(io::Error::from)?;
+        Ok(Self { parent })
+    }
+
+    pub(crate) fn create_new(&self, leaf: &str) -> io::Result<std::fs::File> {
+        validate_leaf(leaf)?;
+        let file = openat(
+            &self.parent,
+            leaf,
+            OFlags::WRONLY
+                | OFlags::CREATE
+                | OFlags::EXCL
+                | OFlags::NOFOLLOW
+                | OFlags::NONBLOCK
+                | OFlags::CLOEXEC,
+            Mode::from_raw_mode(0o600),
+        )
+        .map_err(io::Error::from)?;
+        Ok(std::fs::File::from(file))
+    }
+
+    pub(crate) fn read_bounded(&self, leaf: &str, max_bytes: u64) -> io::Result<String> {
+        validate_leaf(leaf)?;
+        let limit = max_bytes.checked_add(1).ok_or_else(|| {
+            io::Error::new(io::ErrorKind::InvalidInput, "file byte limit overflow")
+        })?;
+        let file = openat(
+            &self.parent,
+            leaf,
+            OFlags::RDONLY | OFlags::NOFOLLOW | OFlags::NONBLOCK | OFlags::CLOEXEC,
+            Mode::empty(),
+        )
+        .map_err(io::Error::from)?;
+        let file = std::fs::File::from(file);
+        if !file.metadata()?.is_file() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "not a regular file",
+            ));
+        }
+        let mut bytes = Vec::new();
+        file.take(limit).read_to_end(&mut bytes)?;
+        if bytes.len() as u64 > max_bytes {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "file exceeds byte limit",
+            ));
+        }
+        String::from_utf8(bytes).map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))
+    }
+
+    pub(crate) fn sync(&self) -> io::Result<()> {
+        fsync(&self.parent).map_err(io::Error::from)
+    }
+
+    pub(crate) fn publish(&self, leaf: &str, content: &[u8]) -> io::Result<AtomicPublication> {
+        self.publish_with_checks(leaf, content, || Ok(()), || self.sync())
+    }
+
+    fn publish_with_checks(
+        &self,
+        leaf: &str,
+        content: &[u8],
+        before_replace: impl FnOnce() -> io::Result<()>,
+        sync_after_replace: impl FnOnce() -> io::Result<()>,
+    ) -> io::Result<AtomicPublication> {
+        validate_leaf(leaf)?;
+        let pending = format!(".pending-{}.json", uuid::Uuid::new_v4());
+        let mut file = self.create_new(&pending)?;
+        file.write_all(content)?;
+        file.sync_all()?;
+        before_replace()?;
+        // Both names are relative to the same still-open directory descriptor.
+        // The existing destination is replaced as an entry, never opened/truncated.
+        renameat(&self.parent, pending.as_str(), &self.parent, leaf).map_err(io::Error::from)?;
+        match sync_after_replace() {
+            Ok(()) => Ok(AtomicPublication::Durable),
+            Err(error) => Ok(AtomicPublication::VisibleButDurabilityUnconfirmed(error)),
+        }
+        // Failures before rename intentionally retain an unreferenced temporary
+        // file. No racy path-based cleanup is performed here.
+    }
+}
+
+fn validate_leaf(leaf: &str) -> io::Result<()> {
+    if leaf.is_empty() || leaf == "." || leaf == ".." || leaf.contains(['/', '\\', ':', '\0']) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "expected a single storage entry name",
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+#[path = "atomic_directory_tests.rs"]
+mod tests;
