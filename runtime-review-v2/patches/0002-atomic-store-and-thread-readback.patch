@@ -0,0 +1,68 @@
+// Copyright 2026 Ubadream
+// SPDX-License-Identifier: Apache-2.0
+
+use super::AtomicPublication;
+use super::Directory;
+use pretty_assertions::assert_eq;
+use std::io;
+
+#[test]
+fn atomic_store_failure_before_replace_preserves_previous_binding() -> io::Result<()> {
+    let temp = tempfile::tempdir()?;
+    let root = temp.path().canonicalize()?;
+    std::fs::write(root.join("binding.json"), "old binding")?;
+    let directory = Directory::open(&root)?;
+    let result = directory.publish_with_checks(
+        "binding.json",
+        b"new binding",
+        || Err(io::Error::other("synthetic failure before rename")),
+        || directory.sync(),
+    );
+    assert!(result.is_err());
+    assert_eq!(directory.read_bounded("binding.json", 1024)?, "old binding");
+    // Deliberately no path-based cleanup: the unrelated entry remains untouched.
+    assert_eq!(std::fs::read_dir(&root)?.count(), 2);
+    Ok(())
+}
+
+#[test]
+fn atomic_store_failure_after_replace_reports_visible_new_binding() -> io::Result<()> {
+    let temp = tempfile::tempdir()?;
+    let root = temp.path().canonicalize()?;
+    std::fs::write(root.join("binding.json"), "old binding")?;
+    let directory = Directory::open(&root)?;
+    let result = directory.publish_with_checks(
+        "binding.json",
+        b"new binding",
+        || Ok(()),
+        || Err(io::Error::other("synthetic directory sync failure")),
+    )?;
+    assert!(matches!(
+        result,
+        AtomicPublication::VisibleButDurabilityUnconfirmed(_)
+    ));
+    assert_eq!(directory.read_bounded("binding.json", 1024)?, "new binding");
+    Ok(())
+}
+
+#[test]
+fn atomic_store_names_are_single_entries_and_never_paths() -> io::Result<()> {
+    let temp = tempfile::tempdir()?;
+    let directory = Directory::open(&temp.path().canonicalize()?)?;
+    for name in [
+        "",
+        ".",
+        "..",
+        "../binding.json",
+        "child/file",
+        "child\\file",
+        "file:stream",
+        "bad\0name",
+    ] {
+        assert!(directory.create_new(name).is_err());
+        assert!(directory.read_bounded(name, 1024).is_err());
+        assert!(directory.publish(name, b"data").is_err());
+    }
+    assert_eq!(std::fs::read_dir(temp.path())?.count(), 0);
+    Ok(())
+}
