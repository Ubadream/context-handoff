+// Copyright 2026 Ubadream
+// SPDX-License-Identifier: Apache-2.0
+
+//! Thread-scoped handoff records stored through held no-follow directory handles.
+//! The caller supplies the authenticated session identity, never a tool argument.
+
+use anyhow::bail;
+use codex_exec_server::AtomicPublication;
+use codex_exec_server::NoFollowDirectory;
+use serde::Deserialize;
