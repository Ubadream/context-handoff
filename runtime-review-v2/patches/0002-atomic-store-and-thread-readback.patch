+// Copyright 2026 Ubadream
+// SPDX-License-Identifier: Apache-2.0
+
+use super::*;
+use pretty_assertions::assert_eq;
+
+fn fixture() -> anyhow::Result<(tempfile::TempDir, Store)> {
+    let directory = tempfile::tempdir()?;
+    let handle = NoFollowDirectory::open(&directory.path().canonicalize()?)?;
+    let store = Store::new(handle, &Uuid::new_v4().to_string())?;
+    Ok((directory, store))
+}
+
+#[test]
+fn handoff_store_freshness_is_required_for_compaction_but_not_historical_readback()
+-> anyhow::Result<()> {
+    let (_directory, store) = fixture()?;
+    let preparation = store.prepare(
+        "request-one",
+        &digest("request text"),
+        "Synthetic saved handoff.",
+        Continuation::Continue,
+    )?;
+    assert_eq!(preparation.durability, Durability::Confirmed);
+    assert_eq!(
+        store.binding_for_request("request-one", &digest("request text"))?,
+        Some(preparation.binding.clone())
+    );
+    assert_eq!(
+        store.binding_for_request("request-two", &digest("new request"))?,
+        None
+    );
+    let page = store.read_current_page(preparation.binding.handoff_id, 0)?;
+    assert!(page.historical_data);
+    assert_eq!(page.text, "Synthetic saved handoff.");
+    assert_eq!(page.source_message_id, "request-one");
+    Ok(())
+}
+
+#[test]
+fn handoff_store_pages_non_ascii_without_skipping_or_splitting_characters() -> anyhow::Result<()> {
+    let (_directory, store) = fixture()?;
+    let text = format!("{}é😀{}", "a".repeat(PAGE_BYTES - 1), "終".repeat(2000));
+    let prepared = store.prepare("request", &digest("request"), &text, Continuation::Wait)?;
+    let id = prepared.binding.handoff_id;
+    let first = store.read_current_page(id, 0)?;
+    assert_eq!(first.next_offset, Some(PAGE_BYTES - 1));
+    assert!(store.read_current_page(id, PAGE_BYTES).is_err());
+    let mut offset = 0;
+    let mut collected = String::new();
+    loop {
+        let page = store.read_current_page(id, offset)?;
+        assert!(page.text.len() <= PAGE_BYTES);
+        assert_eq!(page.offset, offset);
+        assert_eq!(page.total_bytes, text.len());
+        assert_eq!(page.content_sha1, digest(&text));
+        collected.push_str(&page.text);
+        match page.next_offset {
+            Some(next) => {
+                assert!(next > offset);
+                offset = next;
+            }
+            None => break,
+        }
+    }
+    assert_eq!(collected, text);
+    assert!(store.read_current_page(id, text.len() + 1).is_err());
+    let end = store.read_current_page(id, text.len())?;
+    assert_eq!((end.text, end.next_offset), (String::new(), None));
+    Ok(())
+}
+
+#[test]
+fn handoff_store_current_id_supersedes_old_ids_without_removing_snapshots() -> anyhow::Result<()> {
+    let (directory, store) = fixture()?;
+    let old = store.prepare(
+        "request",
+        &digest("request"),
+        "Old synthetic handoff.",
+        Continuation::Wait,
+    )?;
+    let current = store.prepare(
+        "request",
+        &digest("request"),
+        "New synthetic handoff.",
+        Continuation::Wait,
+    )?;
+    assert!(store.read_current_page(old.binding.handoff_id, 0).is_err());
+    assert!(store.read_current_page(Uuid::new_v4(), 0).is_err());
+    assert_eq!(
+        store.read_current_page(current.binding.handoff_id, 0)?.text,
+        "New synthetic handoff."
+    );
+    assert!(
+        directory
+            .path()
+            .join(format!("{}.md", old.binding.handoff_id))
+            .exists()
+    );
+    Ok(())
+}
+
+#[test]
+fn handoff_store_rejects_another_threads_id_even_if_records_are_copied() -> anyhow::Result<()> {
+    let (first_directory, first) = fixture()?;
+    let (second_directory, second) = fixture()?;
+    let first_prepared = first.prepare(
+        "request",
+        &digest("request"),
+        "Thread one synthetic handoff.",
+        Continuation::Wait,
+    )?;
+    let second_prepared = second.prepare(
+        "request",
+        &digest("request"),
+        "Thread two synthetic handoff.",
+        Continuation::Wait,
+    )?;
+    assert!(
+        second
+            .read_current_page(first_prepared.binding.handoff_id, 0)
+            .is_err()
+    );
+    assert!(
+        first
+            .read_current_page(second_prepared.binding.handoff_id, 0)
+            .is_err()
+    );
+    std::fs::copy(
+        first_directory.path().join("binding.json"),
+        second_directory.path().join("binding.json"),
+    )?;
+    let snapshot = format!("{}.md", first_prepared.binding.handoff_id);
+    std::fs::copy(
+        first_directory.path().join(&snapshot),
+        second_directory.path().join(&snapshot),
+    )?;
+    assert!(
+        second
+            .read_current_page(first_prepared.binding.handoff_id, 0)
+            .is_err()
+    );
+    assert!(
+        second
+            .binding_for_request("request", &digest("request"))
+            .is_err()
+    );
+    Ok(())
+}
+
+#[test]
+fn handoff_store_rejects_modified_snapshot_and_preserves_newer_request() -> anyhow::Result<()> {
+    let (directory, store) = fixture()?;
+    let prepared = store.prepare(
+        "request",
+        &digest("request"),
+        "Original synthetic handoff.",
+        Continuation::Wait,
+    )?;
+    std::fs::write(
+        directory
+            .path()
+            .join(format!("{}.md", prepared.binding.handoff_id)),
+        "Changed synthetic handoff.",
+    )?;
+    assert!(
+        store
+            .read_current_page(prepared.binding.handoff_id, 0)
+            .is_err()
+    );
+    assert!(
+        store
+            .binding_for_request("request", &digest("request"))
+            .is_err()
+    );
+    assert_eq!(
+        store.binding_for_request("newer-request", &digest("newer"))?,
+        None
+    );
+    Ok(())
+}
+
+#[test]
+fn handoff_store_rejects_invalid_text_before_creating_any_record() -> anyhow::Result<()> {
+    let (directory, store) = fixture()?;
+    for text in [
+        String::new(),
+        " \n ".to_string(),
+        "x".repeat(MAX_HANDOFF_BYTES as usize + 1),
+    ] {
+        assert!(
+            store
+                .prepare("request", &digest("request"), &text, Continuation::Wait)
+                .is_err()
+        );
+    }
+    assert_eq!(std::fs::read_dir(directory.path())?.count(), 0);
+    Ok(())
+}
+
+#[test]
+fn handoff_store_bounds_serialized_pages_even_when_json_escaping_expands_text() -> anyhow::Result<()>
+{
+    let (_directory, store) = fixture()?;
+    let text = format!("x{}", "\0".repeat(12_000));
+    let source_id = "\0".repeat(MAX_SOURCE_ID_BYTES);
+    let prepared = store.prepare(
+        &source_id,
+        &digest("synthetic request"),
+        &text,
+        Continuation::Wait,
+    )?;
+    let mut offset = 0;
+    let mut collected = String::new();
+    loop {
+        let page = store.read_current_page(prepared.binding.handoff_id, offset)?;
+        assert!(serde_json::to_vec(&page)?.len() <= MAX_PAGE_JSON_BYTES);
+        assert!(serialize_read_result(&page)?.len() <= MAX_TOOL_RESULT_BYTES);
+        assert!(page.text.len() <= PAGE_BYTES);
+        collected.push_str(&page.text);
+        match page.next_offset {
+            Some(next) => {
+                assert!(next > offset);
+                offset = next;
+            }
+            None => break,
+        }
+    }
+    assert_eq!(collected, text);
+    Ok(())
+}
