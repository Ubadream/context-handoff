+// Copyright 2026 Ubadream
+// SPDX-License-Identifier: Apache-2.0
+
+use super::read;
+use codex_exec_server::FileSystemReadStream;
+use futures::stream;
+use pretty_assertions::assert_eq;
+use std::io;
+use std::time::Duration;
+use tokio_util::sync::CancellationToken;
+
+#[tokio::test]
+async fn handoff_stream_accepts_utf8_split_across_chunks() -> io::Result<()> {
+    let input = FileSystemReadStream::new(stream::iter(vec![
+        Ok(vec![b'c', b'a', b'f', 0xc3].into()),
+        Ok(vec![0xa9].into()),
+    ]));
+    assert_eq!(read(input, &CancellationToken::new()).await?, "café");
+    Ok(())
+}
+
+#[tokio::test]
+async fn handoff_stream_rejects_growth_beyond_the_original_metadata_bound() {
+    let input = FileSystemReadStream::new(stream::iter(vec![
+        Ok(vec![b'x'; crate::handoff_binding::MAX_HANDOFF_BYTES as usize].into()),
+        Ok(vec![b'y'].into()),
+    ]));
+    let error = read(input, &CancellationToken::new())
+        .await
+        .expect_err("bounded stream");
+    assert_eq!(error.kind(), io::ErrorKind::InvalidData);
+}
+
+#[tokio::test]
+async fn handoff_stream_cancellation_interrupts_an_idle_source() {
+    let cancellation = CancellationToken::new();
+    let reader_cancellation = cancellation.clone();
+    let reader = tokio::spawn(async move {
+        read(
+            FileSystemReadStream::new(stream::pending()),
+            &reader_cancellation,
+        )
+        .await
+    });
+    cancellation.cancel();
+    let error = tokio::time::timeout(Duration::from_secs(1), reader)
+        .await
+        .expect("cancellation must not wait for another stream item")
+        .expect("reader task")
+        .expect_err("cancelled stream");
+    assert_eq!(error.kind(), io::ErrorKind::Interrupted);
+}
+
+#[tokio::test]
+async fn handoff_stream_propagates_io_and_utf8_errors() {
+    let denied = FileSystemReadStream::new(stream::iter(vec![Err(io::Error::new(
+        io::ErrorKind::PermissionDenied,
+        "synthetic policy denial",
+    ))]));
+    assert_eq!(
+        read(denied, &CancellationToken::new())
+            .await
+            .unwrap_err()
+            .kind(),
+        io::ErrorKind::PermissionDenied
+    );
+    let invalid = FileSystemReadStream::new(stream::iter(vec![Ok(vec![0xff].into())]));
+    assert_eq!(
+        read(invalid, &CancellationToken::new())
+            .await
+            .unwrap_err()
+            .kind(),
+        io::ErrorKind::InvalidData
+    );
+}
