+use std::io::Write;
+use uuid::Uuid;
+
+pub(crate) const MAX_HANDOFF_BYTES: u64 = 32 * 1024;
+const MAX_BINDING_BYTES: u64 = 8 * 1024;
+const MAX_SOURCE_ID_BYTES: usize = 1024;
+const PAGE_BYTES: usize = 4 * 1024;
+// JSON escaping can expand a control byte to six bytes. Bound the actual
+// serialized page, leaving room for the tool envelope below 8 KiB of visible text.
+const MAX_PAGE_JSON_BYTES: usize = 7 * 1024;
+const MAX_TOOL_RESULT_BYTES: usize = 8 * 1024;
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum Continuation {
+    Continue,
+    Wait,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Binding {
+    schema_version: u8,
+    pub(crate) thread_id: String,
+    pub(crate) source_message_id: String,
+    source_text_sha1: String,
+    pub(crate) handoff_id: Uuid,
+    handoff_sha1: String,
+    pub(crate) continuation: Continuation,
+}
+
+#[derive(Clone, Copy, Debug, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum Durability {
+    Confirmed,
+    VisibleUnconfirmed,
+}
+
+#[derive(Debug)]
+pub(crate) struct Preparation {
+    pub(crate) binding: Binding,
+    pub(crate) durability: Durability,
+}
+
+#[derive(Debug, Serialize, PartialEq, Eq)]
+pub(crate) struct HistoricalPage {
+    pub(crate) handoff_id: Uuid,
+    pub(crate) historical_data: bool,
+    pub(crate) source_message_id: String,
+    pub(crate) offset: usize,
+    pub(crate) next_offset: Option<usize>,
+    pub(crate) total_bytes: usize,
+    pub(crate) content_sha1: String,
+    pub(crate) text: String,
+}
+
+pub(crate) struct Store {
+    directory: NoFollowDirectory,
+    thread_id: String,
+}
+
+pub(crate) fn digest(text: &str) -> String {
+    // Local change detection only. This does not authenticate hostile same-UID writers.
+    format!("{:x}", Sha1::digest(text.as_bytes()))
+}
+
+pub(crate) fn serialize_read_result(page: &HistoricalPage) -> anyhow::Result<String> {
+    let output = serde_json::json!({
+        "handoff_page": page,
+        "content_kind": "historical_data",
+        "durability": "confirmed_on_read",
+    })
+    .to_string();
+    if output.len() > MAX_TOOL_RESULT_BYTES {
+        bail!("Serialized handoff tool result exceeds 8 KiB");
+    }
+    Ok(output)
+}
+
+impl Store {
+    pub(crate) fn new(directory: NoFollowDirectory, thread_id: &str) -> anyhow::Result<Self> {
+        let thread_id = Uuid::parse_str(thread_id)?.to_string();
+        Ok(Self {
+            directory,
+            thread_id,
+        })
+    }
+
+    pub(crate) fn prepare(
+        &self,
+        source_message_id: &str,
+        source_text_sha1: &str,
+        text: &str,
+        continuation: Continuation,
+    ) -> anyhow::Result<Preparation> {
+        if text.trim().is_empty() || text.len() as u64 > MAX_HANDOFF_BYTES {
+            bail!("Handoff must contain non-empty UTF-8 text of at most 32 KiB");
+        }
+        if source_message_id.is_empty()
+            || source_message_id.len() > MAX_SOURCE_ID_BYTES
+            || !is_digest(source_text_sha1)
+        {
+            bail!("Invalid source request identity");
+        }
+        let binding = Binding {
+            schema_version: 1,
+            thread_id: self.thread_id.clone(),
+            source_message_id: source_message_id.to_string(),
+            source_text_sha1: source_text_sha1.to_string(),
+            handoff_id: Uuid::new_v4(),
+            handoff_sha1: digest(text),
+            continuation,
+        };
+        let record = serde_json::to_vec(&binding)?;
+        if record.len() as u64 > MAX_BINDING_BYTES {
+            bail!("Handoff binding exceeds its storage bound");
+        }
+        let leaf = format!("{}.md", binding.handoff_id);
+        let mut snapshot = self.directory.create_new(&leaf)?;
+        snapshot.write_all(text.as_bytes())?;
+        snapshot.sync_all()?;
+        self.directory.sync()?;
+        if self.directory.read_bounded(&leaf, MAX_HANDOFF_BYTES)? != text {
+            bail!("Handoff snapshot read-back did not match");
+        }
+        let durability = match self.directory.publish("binding.json", &record)? {
+            AtomicPublication::Durable => Durability::Confirmed,
+            AtomicPublication::VisibleButDurabilityUnconfirmed(_error) => {
+                Durability::VisibleUnconfirmed
+            }
+        };
+        Ok(Preparation {
+            binding,
+            durability,
+        })
+    }
+
+    pub(crate) fn binding_for_request(
+        &self,
+        source_message_id: &str,
+        source_text_sha1: &str,
+    ) -> anyhow::Result<Option<Binding>> {
+        let Some(binding) = self.read_binding()? else {
+            return Ok(None);
+        };
+        if binding.source_message_id != source_message_id
+            || binding.source_text_sha1 != source_text_sha1
+        {
+            return Ok(None);
+        }
+        self.read_snapshot(&binding)?;
+        // A previous post-rename sync error is reconciled through a real sync,
+        // never a second blind write of the index.
+        self.directory.sync()?;
+        if self.read_binding()?.as_ref() != Some(&binding) {
+            bail!("Handoff binding changed during verification");
+        }
+        Ok(Some(binding))
+    }
+
+    pub(crate) fn read_current_page(
+        &self,
+        handoff_id: Uuid,
+        offset: usize,
+    ) -> anyhow::Result<HistoricalPage> {
+        let binding = self
+            .read_binding()?
+            .ok_or_else(|| anyhow::anyhow!("No current thread handoff"))?;
+        if binding.handoff_id != handoff_id {
+            bail!("Handoff ID is not current in this thread");
+        }
+        let text = self.read_snapshot(&binding)?;
+        if offset > text.len() || !text.is_char_boundary(offset) {
+            bail!("Handoff offset must be a valid UTF-8 byte boundary");
+        }
+        let mut end = offset.saturating_add(PAGE_BYTES).min(text.len());
+        while !text.is_char_boundary(end) {
+            end -= 1;
+        }
+        self.directory.sync()?;
+        if self.read_binding()?.as_ref() != Some(&binding) {
+            bail!("Handoff binding changed during readback");
+        }
+        let mut page = HistoricalPage {
+            handoff_id,
+            historical_data: true,
+            source_message_id: binding.source_message_id,
+            offset,
+            next_offset: (end < text.len()).then_some(end),
+            total_bytes: text.len(),
+            content_sha1: binding.handoff_sha1,
+            text: text[offset..end].to_string(),
+        };
+        while serde_json::to_vec(&page)?.len() > MAX_PAGE_JSON_BYTES {
+            let mut length = page.text.len() / 2;
+            while !page.text.is_char_boundary(length) {
+                length -= 1;
+            }
+            if length == 0 {
+                bail!("Handoff metadata does not fit a bounded output page");
+            }
+            page.text.truncate(length);
+            page.next_offset = Some(offset + length);
+        }
+        Ok(page)
+    }
+
+    fn read_binding(&self) -> anyhow::Result<Option<Binding>> {
+        let text = match self
+            .directory
+            .read_bounded("binding.json", MAX_BINDING_BYTES)
+        {
+            Ok(text) => text,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+            Err(error) => return Err(error.into()),
+        };
+        let binding: Binding = serde_json::from_str(&text)
+            .map_err(|_| anyhow::anyhow!("Invalid handoff binding record"))?;
+        if binding.schema_version != 1
+            || binding.thread_id != self.thread_id
+            || binding.handoff_id.get_version_num() != 4
+            || binding.source_message_id.is_empty()
+            || binding.source_message_id.len() > MAX_SOURCE_ID_BYTES
+            || !is_digest(&binding.source_text_sha1)
+            || !is_digest(&binding.handoff_sha1)
+        {
+            bail!("Handoff binding does not belong to this thread or schema");
+        }
+        Ok(Some(binding))
+    }
+
+    fn read_snapshot(&self, binding: &Binding) -> anyhow::Result<String> {
+        let text = self
+            .directory
+            .read_bounded(&format!("{}.md", binding.handoff_id), MAX_HANDOFF_BYTES)?;
+        if text.trim().is_empty() || digest(&text) != binding.handoff_sha1 {
+            bail!("Handoff snapshot changed; preserve the original request");
+        }
+        Ok(text)
+    }
+}
+
+fn is_digest(value: &str) -> bool {
+    value.len() == 40
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
