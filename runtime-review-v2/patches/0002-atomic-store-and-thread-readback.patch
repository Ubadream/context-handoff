+/// The outcome after an atomic directory-entry replacement has become visible.
+/// An error returned by the operation itself means replacement did not complete.
+#[derive(Debug)]
+pub enum AtomicPublication {
+    Durable,
+    /// The replacement is visible, but directory durability could not be confirmed.
+    /// Read/reconcile current state before retrying; the old entry is not preserved.
+    VisibleButDurabilityUnconfirmed(io::Error),
+}
+
+/// A held no-follow directory handle for bounded reads and atomic publication.
+///
+/// This protects path traversal and entry replacement, not hostile processes with
+/// the same OS identity and write access to the held directory. Store ownership
+/// and the execution sandbox remain part of the security boundary.
+#[derive(Debug)]
+pub struct NoFollowDirectory {
+    inner: imp::Directory,
+}
+
+impl NoFollowDirectory {
+    pub fn open(path: &Path) -> io::Result<Self> {
+        imp::Directory::open(path).map(|inner| Self { inner })
+    }
+
+    /// Creates an exclusive new entry relative to this still-open directory.
+    pub fn create_new(&self, leaf: &str) -> io::Result<std::fs::File> {
+        self.inner.create_new(leaf)
+    }
+
+    /// Reads at most the configured UTF-8 byte bound through this directory handle.
+    pub fn read_bounded(&self, leaf: &str, max_bytes: u64) -> io::Result<String> {
+        self.inner.read_bounded(leaf, max_bytes)
+    }
+
+    /// Syncs this directory after publishing immutable, exclusive-created entries.
+    pub fn sync(&self) -> io::Result<()> {
+        self.inner.sync()
+    }
+
+    /// Atomically replaces a single entry without opening or truncating its target.
+    /// Pre-replacement failures can leave unreferenced private temporary files.
+    pub fn publish(&self, leaf: &str, content: &[u8]) -> io::Result<AtomicPublication> {
+        self.inner.publish(leaf, content)
+    }
+}
