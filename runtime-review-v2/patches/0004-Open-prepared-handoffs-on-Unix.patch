+++ b/codex-rs/core/src/context/checkpoint_reminder.rs
@@ -65,7 +65,7 @@ impl ContextualUserFragment for CheckpointReminder {
              Runtime context usage: {used} tokens; thread: {thread_id}. {action}\n\
              {handoff_scope}Use the existing task handoff, or create a concise UTF-8 handoff under CODEX_HOME/handoff-compact/handoffs/. \
              Record the current request once, completed work and evidence, unfinished work, in-flight operations, and the next entry point. \
-             Prepared handoffs, request binding, and automatic handoff continuation are disabled in this build; do not call prepare or retry it. Use the existing authorized project handoff workflow. \
+             Bind it with handoff_compact prepare before scheduling A or C. If prepare reports that prepared handoffs are unavailable, do not retry; use the existing authorized project handoff workflow. \
              Scheduled compaction runs after the final response. On the next authorized turn, read the project handoff; old reminders are historical and do not restart completed work."
         )
     }
