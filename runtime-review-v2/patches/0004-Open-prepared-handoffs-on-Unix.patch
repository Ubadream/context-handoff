 }
 
-/// Native integration and platform verification are still required. This gate
-/// has no configuration or environment-variable bypass.
+/// Prepared handoffs need the atomic no-follow store, implemented on Unix only.
+/// Elsewhere this stays closed; there is no configuration or environment-variable bypass.
 pub(crate) fn ensure_storage_available() -> anyhow::Result<()> {
-    bail!(
-        "Prepared handoffs are disabled pending atomic no-follow storage and native integration validation"
-    )
+    if cfg!(unix) {
+        return Ok(());
+    }
+    bail!("Prepared handoffs need atomic no-follow publication, which this build implements only on Unix")
 }
 
