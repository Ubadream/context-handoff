 codex-rs/core/src/handoff_binding.rs          | 11 +++++-----
 .../src/tools/handlers/handoff_compact.rs     |  2 +-
 codex-rs/core/tests/suite/handoff_compact.rs  | 10 ++++-----
 .../tests/suite/handoff_compact_security.rs   | 21 ++++++++++++-------
 5 files changed, 26 insertions(+), 20 deletions(-)

diff --git a/codex-rs/core/src/context/checkpoint_reminder.rs b/codex-rs/core/src/context/checkpoint_reminder.rs
