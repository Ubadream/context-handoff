+    let rollout = std::fs::read_to_string(test.codex.rollout_path().expect("rollout path"))?;
+    let checkpoint = rollout
+        .lines()
+        .map(serde_json::from_str::<serde_json::Value>)
+        .collect::<std::result::Result<Vec<_>, _>>()?
+        .into_iter()
+        .find(|record| record["type"] == "compacted")
+        .expect("native compaction checkpoint");
+    let replacement = checkpoint["payload"]["replacement_history"].to_string();
+    assert!(
+        replacement.contains("C compaction:"),
+        "archive pointer must be persisted with the summary"
+    );
+    assert!(replacement.contains("NATIVE_SUMMARY"));
+    Ok(())
