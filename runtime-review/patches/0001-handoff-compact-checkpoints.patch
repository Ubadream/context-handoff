@@ -0,0 +1,58 @@
+// Copyright 2026 Ubadream
+// SPDX-License-Identifier: Apache-2.0
+
+use super::ContextualUserFragment;
+use codex_protocol::models::ContentItemKind;
+
+pub(crate) struct CheckpointReminder {
+    pub(crate) window_id: String,
+    pub(crate) thread_id: String,
+    pub(crate) used: i64,
+    pub(crate) threshold: i64,
+    pub(crate) compact_threshold: i64,
+    pub(crate) review_threshold: Option<i64>,
+}
+
+impl ContextualUserFragment for CheckpointReminder {
+    fn content_kind(&self) -> ContentItemKind {
+        ContentItemKind("context.checkpoint_reminder".to_string())
+    }
+
+    fn role(&self) -> &'static str {
+        "developer"
+    }
+
+    fn markers(&self) -> (&'static str, &'static str) {
+        Self::type_markers()
+    }
+
+    fn type_markers() -> (&'static str, &'static str) {
+        ("<context_checkpoint_reminder>", "</context_checkpoint_reminder>")
+    }
+
+    fn body(&self) -> String {
+        let Self {
+            window_id, thread_id, used, threshold, compact_threshold, review_threshold,
+        } = self;
+        let action = if review_threshold == &Some(*threshold) {
+            format!("Reached {threshold} tokens. Review task completion. Pending reviews, unfinished tests, and unsaved outputs are not complete. If authorized work remains, continue it; this review does not require compaction or authorize new work.")
+        } else if threshold == compact_threshold {
+            format!("Reached {threshold} tokens. Save changes, read back the existing project handoff, and request A or C compaction at the next safe boundary. Finish in-flight operations before starting another work stage.")
+        } else {
+            format!("Reached {threshold} tokens. Update and read back the handoff. Preserve references to details still needed. If the next operation may exceed {compact_threshold} tokens, compact at a safe boundary first; otherwise continue within existing authorization.")
+        };
+        let handoff_scope = if review_threshold == &Some(*threshold) {
+            "Follow the handoff steps only when there are changes to preserve or compaction is appropriate. "
+        } else {
+            ""
+        };
+        format!(
+            "window_id={window_id}; threshold={threshold}\n\
+             Runtime context usage: {used} tokens; thread: {thread_id}. {action}\n\
+             {handoff_scope}Use the existing task handoff, or create a concise UTF-8 handoff under CODEX_HOME/handoff-compact/handoffs/. \
+             Record the current request once, completed work and evidence, unfinished work, in-flight operations, and the next entry point. \
+             Prepared handoffs, request binding, and automatic handoff continuation are disabled in this build; do not call prepare or retry it. Use the existing authorized project handoff workflow. \
+             Scheduled compaction runs after the final response. On the next authorized turn, read the project handoff; old reminders are historical and do not restart completed work."
+        )
+    }
+}
