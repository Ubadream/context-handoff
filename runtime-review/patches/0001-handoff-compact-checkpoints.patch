+#[tokio::test]
+async fn checkpoint_reminder_threshold_config_loads_and_rejects_unreachable_stages()
+-> std::io::Result<()> {
+    let codex_home = tempdir()?;
+    let load = |text: &str| {
+        Config::load_from_base_config_with_overrides(
+            toml::from_str(text).expect("valid TOML"),
+            ConfigOverrides::default(),
+            codex_home.abs(),
+        )
+    };
+    let custom = load("context_checkpoint_reminders = true\ncontext_checkpoint_review_tokens = 265000\ncontext_checkpoint_prepare_tokens = 350000\ncontext_checkpoint_compact_tokens = 430000\nmodel_context_window = 500000\nmodel_auto_compact_token_limit = 450000\n").await?;
+    assert_eq!(
+        (
+            custom.context_checkpoint_review_tokens,
+            custom.context_checkpoint_prepare_tokens,
+            custom.context_checkpoint_compact_tokens
+        ),
+        (Some(265_000), 350_000, 430_000)
+    );
+    let legacy = load("").await?;
+    assert_eq!(
+        (
+            legacy.context_checkpoint_prepare_tokens,
+            legacy.context_checkpoint_compact_tokens
+        ),
+        (240_000, 265_000)
+    );
+    assert_eq!(legacy.context_checkpoint_review_tokens, None);
+    for text in [
+        "context_checkpoint_prepare_tokens = 0",
+        "context_checkpoint_review_tokens = 0",
+        "context_checkpoint_review_tokens = 350000\ncontext_checkpoint_prepare_tokens = 350000",
+        "context_checkpoint_prepare_tokens = 430000\ncontext_checkpoint_compact_tokens = 350000",
+        "context_checkpoint_reminders = true\ncontext_checkpoint_compact_tokens = 450000\nmodel_context_window = 500000",
+        "context_checkpoint_reminders = true\ncontext_checkpoint_compact_tokens = 430000\nmodel_auto_compact_token_limit = 420000",
+    ] {
+        let error = load(text).await.expect_err("invalid reminder thresholds");
+        assert_eq!(error.kind(), std::io::ErrorKind::InvalidInput);
+    }
+    Ok(())
+}
