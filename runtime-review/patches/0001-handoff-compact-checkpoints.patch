+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn handoff_compact_c_waits_for_final_and_archives_it() -> Result<()> {
+    let server = responses::start_mock_server().await;
+    let mock = responses::mount_sse_sequence(
+        &server,
+        vec![
+            select("select-c", "C"),
+            reply("final", "Final sentence  preserve whitespace"),
+            reply("summary", "NATIVE_SUMMARY"),
+            reply("next", "continued"),
+        ],
+    )
+    .await;
+    let test = test_codex()
+        .with_config(|config| {
