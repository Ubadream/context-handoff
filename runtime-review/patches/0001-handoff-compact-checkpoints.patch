+/// Creates a new regular file without following symlinks/reparse points in any
+/// path component. Existing entries fail rather than being opened or truncated.
+/// The returned handle is the only handle callers should use to write the file.
+pub fn create_new_file_no_follow(path: &Path) -> io::Result<std::fs::File> {
+    imp::create_new_file_sync(path)
+}
+
+/// Opens a regular file through the existing platform no-follow implementation.
+/// Callers must bound their reads or stream input rather than loading arbitrary data.
+pub fn open_regular_file_no_follow(path: &Path) -> io::Result<std::fs::File> {
+    imp::open_file_sync(path)
+}
+
+/// Reads a regular UTF-8 file through a no-follow handle, rejecting oversized
+/// files instead of truncating. Ancestor and final-component links are rejected.
+pub fn read_bounded_file_no_follow(path: &Path, max_bytes: u64) -> io::Result<String> {
+    let limit = max_bytes.checked_add(1).ok_or_else(|| {
+        io::Error::new(io::ErrorKind::InvalidInput, "file byte limit overflow")
+    })?;
+    let file = open_regular_file_no_follow(path)?;
+    let mut bytes = Vec::new();
+    file.take(limit).read_to_end(&mut bytes)?;
+    if bytes.len() as u64 > max_bytes {
+        return Err(io::Error::new(io::ErrorKind::InvalidData, "file exceeds byte limit"));
+    }
+    String::from_utf8(bytes).map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))
+}
