+use super::create_new_file_no_follow;
+use super::read_bounded_file_no_follow;
+use pretty_assertions::assert_eq;
+use std::io::Write;
+
+#[test]
+fn no_follow_store_create_new_and_bounded_utf8_round_trip() -> std::io::Result<()> {
+    let dir = tempfile::tempdir()?;
+    // Canonicalize only this owned test fixture so macOS /var aliases do not
+    // obscure the ancestor-link behavior being tested. Production does not do this.
+    let root = dir.path().canonicalize()?;
+    let path = root.join("snapshot.md");
+    let text = "Synthetic handoff: café";
+    let mut file = create_new_file_no_follow(&path)?;
+    file.write_all(text.as_bytes())?;
+    file.sync_all()?;
+    assert_eq!(read_bounded_file_no_follow(&path, text.len() as u64)?, text);
+    assert!(read_bounded_file_no_follow(&path, text.len() as u64 - 1).is_err());
+    assert!(create_new_file_no_follow(&path).is_err());
+    assert_eq!(std::fs::read_to_string(path)?, text);
+    Ok(())
+}
+
+#[test]
+fn no_follow_store_create_new_rejects_existing_hardlink_without_clobber() -> std::io::Result<()> {
+    let dir = tempfile::tempdir()?;
+    let root = dir.path().canonicalize()?;
+    let original = root.join("original.txt");
+    let candidate = root.join("snapshot.md");
+    std::fs::write(&original, "SYNTHETIC_ORIGINAL")?;
+    std::fs::hard_link(&original, &candidate)?;
+    assert!(create_new_file_no_follow(&candidate).is_err());
+    assert_eq!(std::fs::read_to_string(original)?, "SYNTHETIC_ORIGINAL");
+    assert_eq!(std::fs::read_to_string(candidate)?, "SYNTHETIC_ORIGINAL");
+    Ok(())
+}
+
+#[test]
+fn no_follow_store_rejects_invalid_utf8_and_directories() -> std::io::Result<()> {
+    let dir = tempfile::tempdir()?;
+    let root = dir.path().canonicalize()?;
+    let path = root.join("invalid.md");
+    let mut file = create_new_file_no_follow(&path)?;
+    file.write_all(&[0xff, 0xfe])?;
+    file.sync_all()?;
+    assert!(read_bounded_file_no_follow(&path, 32).is_err());
+    assert!(read_bounded_file_no_follow(&root, 32).is_err());
+    assert!(create_new_file_no_follow(&root).is_err());
+    Ok(())
+}
+
+#[cfg(unix)]
+#[test]
+fn no_follow_store_rejects_final_and_ancestor_symlinks() -> std::io::Result<()> {
+    let dir = tempfile::tempdir()?;
+    let root = dir.path().canonicalize()?;
+    let outside = root.join("outside");
+    std::fs::create_dir(&outside)?;
+    std::fs::write(outside.join("source.md"), "SYNTHETIC_OUTSIDE")?;
+    let final_link = root.join("snapshot.md");
+    std::os::unix::fs::symlink(outside.join("source.md"), &final_link)?;
+    assert!(read_bounded_file_no_follow(&final_link, 32).is_err());
+    assert!(create_new_file_no_follow(&final_link).is_err());
+    let parent_link = root.join("store");
+    std::os::unix::fs::symlink(&outside, &parent_link)?;
+    assert!(read_bounded_file_no_follow(&parent_link.join("source.md"), 32).is_err());
+    assert!(create_new_file_no_follow(&parent_link.join("new.md")).is_err());
+    assert!(!outside.join("new.md").exists());
+    assert_eq!(std::fs::read_to_string(outside.join("source.md"))?, "SYNTHETIC_OUTSIDE");
+    Ok(())
+}
+
+#[cfg(windows)]
+#[test]
+#[ignore = "requires Windows symlink privilege or developer mode; run explicitly in Windows security CI"]
+fn no_follow_store_rejects_windows_final_and_ancestor_reparse_points() -> std::io::Result<()> {
+    let dir = tempfile::tempdir()?;
+    let root = dir.path().canonicalize()?;
+    let outside = root.join("outside");
+    std::fs::create_dir(&outside)?;
+    std::fs::write(outside.join("source.md"), "SYNTHETIC_OUTSIDE")?;
+    let final_link = root.join("snapshot.md");
+    std::os::windows::fs::symlink_file(outside.join("source.md"), &final_link)?;
+    assert!(read_bounded_file_no_follow(&final_link, 32).is_err());
+    assert!(create_new_file_no_follow(&final_link).is_err());
+    let parent_link = root.join("store");
+    std::os::windows::fs::symlink_dir(&outside, &parent_link)?;
+    assert!(read_bounded_file_no_follow(&parent_link.join("source.md"), 32).is_err());
+    assert!(create_new_file_no_follow(&parent_link.join("new.md")).is_err());
+    assert!(!outside.join("new.md").exists());
+    Ok(())
+}
