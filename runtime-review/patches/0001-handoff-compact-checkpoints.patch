diff --git a/codex-rs/core/src/handoff_binding.rs b/codex-rs/core/src/handoff_binding.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bcf03e528935435d23abd3451562eb01d9a18d4e
--- /dev/null
+++ b/codex-rs/core/src/handoff_binding.rs
@@ -0,0 +1,229 @@
+// Copyright 2026 Ubadream
+// SPDX-License-Identifier: Apache-2.0
+
+//! Task-bound handoff for the last request, independent of the summary writer.
+use crate::compact::is_summary_message;
+use crate::context::ContextualUserFragment;
+use crate::context::HandoffCompactNotice;
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+use anyhow::Context;
+use anyhow::bail;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::items::TurnItem;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use serde::Deserialize;
+use serde::Serialize;
+use sha1::Digest;
+use sha1::Sha1;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+pub(crate) const MAX_HANDOFF_BYTES: u64 = 32 * 1024;
+
+/// Fixed-index publication is intentionally unavailable until a cross-platform,
+/// directory-handle-anchored atomic replace operation has been implemented and tested.
+/// There is no configuration or environment-variable bypass for this gate.
+pub(crate) fn ensure_storage_available() -> anyhow::Result<()> {
+    bail!("Prepared handoffs are disabled pending atomic no-follow snapshot-index publication")
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum Continuation {
+    Continue,
+    Wait,
+}
+
+#[derive(Deserialize, Serialize)]
+pub(crate) struct Binding {
+    thread_id: String,
+    source_message_id: String,
+    source_text_sha1: String,
+    pub(crate) handoff_path: PathBuf,
+    handoff_sha1: String,
+    continuation: Continuation,
+}
+
+fn digest(text: &str) -> String {
+    // Change detection for local owned files, not authentication of untrusted data.
+    format!("{:x}", Sha1::digest(text.as_bytes()))
+}
+
+fn read_bounded(path: &Path) -> anyhow::Result<String> {
+    let text = codex_exec_server::read_bounded_file_no_follow(path, MAX_HANDOFF_BYTES)?;
+    if text.trim().is_empty() {
+        bail!("Handoff must not be empty");
+    }
+    Ok(text)
+}
+
+pub(crate) fn request_text(item: &ResponseItem) -> Option<String> {
+    match crate::event_mapping::parse_turn_item(item) {
+        Some(TurnItem::UserMessage(message)) if !is_summary_message(&message.message()) => {
+            Some(message.message())
+        }
+        _ => None,
+    }
+}
+
+async fn last_request(sess: &Session) -> Option<(String, String)> {
+    let history = sess.clone_history().await;
+    history.annotated_items().iter().rev().find_map(|envelope| {
+        let item = &envelope.item;
+        let text = request_text(item)?;
+        Some((item.id()?.to_string(), digest(&text)))
+    })
+}
+
+/// Freeze handoff text already read through the selected environment's filesystem policy.
+/// The caller must not pass text from an unrestricted host-path read.
+pub(crate) async fn prepare(
+    sess: &Session,
+    turn: &TurnContext,
+    text: &str,
+    continuation: Continuation,
+) -> anyhow::Result<Binding> {
+    ensure_storage_available()?;
+    if text.len() as u64 > MAX_HANDOFF_BYTES || text.trim().is_empty() {
+        bail!("Handoff must contain non-empty UTF-8 text of at most 32 KiB");
+    }
+    let (source_message_id, source_text_sha1) = last_request(sess)
+        .await
+        .context("No user request in this thread can be bound")?;
+    let root = turn
+        .config
+        .codex_home
+        .join("handoff-compact/handoffs")
+        .join(sess.thread_id.to_string());
+    if root.to_string_lossy().len() > 1024 {
+        bail!("Handoff directory path is too long");
+    }
+    codex_exec_server::ExecutorFileSystem::create_directory(
+        &codex_exec_server::LocalFileSystem::unsandboxed(),
+        &codex_utils_path_uri::PathUri::from_host_native_path(&root)?,
+        codex_exec_server::CreateDirectoryOptions {
+            recursive: true,
+            follow_symlinks: false,
+        },
+        /*sandbox*/ None,
+    ).await?;
+    let snapshot = root.join(format!("{}.md", uuid::Uuid::new_v4()));
+    let mut file = codex_exec_server::create_new_file_no_follow(&snapshot)?;
+    file.write_all(text.as_bytes())?;
+    file.sync_all()?;
+    if read_bounded(&snapshot)? != text {
+        bail!("Handoff snapshot read-back did not match");
+    }
+    let binding = Binding {
+        thread_id: sess.thread_id.to_string(),
+        source_message_id,
+        source_text_sha1,
+        handoff_path: snapshot.to_path_buf(),
+        handoff_sha1: digest(text),
+        continuation,
+    };
+    // Never fall back to path-based tempfile/rename or truncate an existing index.
+    // Keep the immutable snapshot unreferenced until a safe atomic index writer exists.
+    let _ = binding;
+    bail!("Atomic handoff-index publication is not implemented")
+}
+
+pub(crate) async fn load(sess: &Session, turn: &TurnContext) -> anyhow::Result<Option<Binding>> {
+    if ensure_storage_available().is_err() {
+        // Ordinary native compaction must keep the original user request when the
+        // optional handoff store is unavailable, without touching any saved index.
+        return Ok(None);
+    }
+    let root = turn
+        .config
+        .codex_home
+        .join("handoff-compact/handoffs")
+        .join(sess.thread_id.to_string());
+    let text = match read_bounded(&root.join("binding.json")) {
+        Ok(text) => text,
+        Err(error)
+            if error
+                .downcast_ref::<std::io::Error>()
+                .is_some_and(|e| e.kind() == std::io::ErrorKind::NotFound) =>
+        {
+            return Ok(None);
+        }
+        Err(error) => return Err(error),
+    };
+    let binding: Binding = serde_json::from_str(&text)?;
+    if binding.thread_id != sess.thread_id.to_string()
+        || binding.handoff_path.parent() != Some(root.as_path())
+    {
+        bail!("Handoff binding does not belong to this thread");
+    }
+    if last_request(sess).await
+        != Some((
+            binding.source_message_id.clone(),
+            binding.source_text_sha1.clone(),
+        ))
+    {
+        // A newer request must never be replaced by a handoff for an older one.
+        return Ok(None);
+    }
+    if digest(&read_bounded(&binding.handoff_path)?) != binding.handoff_sha1 {
+        bail!("Handoff snapshot changed; keep the original request and reject this binding");
+    }
+    Ok(Some(binding))
+}
+
+pub(crate) async fn append(
+    sess: &Session,
+    binding: &Binding,
+    history: &mut Vec<ResponseItemEnvelope>,
+) {
+    let next = match binding.continuation {
+        Continuation::Continue => "Read the handoff and continue only unfinished work already authorized by the user.",
+        Continuation::Wait => "Read the handoff to confirm the stopping point. Work is complete or awaiting the user decision; do not start new work.",
+    };
+    history.push(ResponseItemEnvelope::new(ContextualUserFragment::into(HandoffCompactNotice(format!(
+        "Compaction complete. Handoff for thread {}: {} (content fingerprint {}). {next} The handoff records the request and completed and unfinished work. Original text remains in the source rollout as historical data. Newer user messages take precedence.",
+        binding.thread_id, binding.handoff_path.display(), binding.handoff_sha1,
+    )))));
+    let turn_state = {
+        let active = sess.active_turn.lock().await;
+        active
+            .as_ref()
+            .map(|active| std::sync::Arc::clone(&active.turn_state))
+    };
+    if let Some(state) = turn_state {
+        state.lock().await.handoff_binding_resume = binding.continuation == Continuation::Continue;
+    }
+}
+
+/// Replace the covered remote request by identity, preserving any media payloads.
+pub(crate) fn remove_covered(binding: &Binding, history: &mut Vec<ResponseItemEnvelope>) {
+    if let Some(index) = history.iter().rposition(|item| {
+        item.item
+            .id()
+            .is_some_and(|id| id.to_string() == binding.source_message_id)
+    }) {
+        if let ResponseItem::Message { content, .. } = &mut history[index].item
+            && content.iter().any(|item| {
+                matches!(
+                    item,
+                    ContentItem::InputImage { .. } | ContentItem::InputAudio { .. }
+                )
+            })
+        {
+            for item in content {
+                if let ContentItem::InputText { text } = item {
+                    *text = "Original request text is covered by the thread handoff; attachments are preserved.".to_string();
+                }
+            }
+            return;
+        }
+        history.remove(index);
+    }
+}
