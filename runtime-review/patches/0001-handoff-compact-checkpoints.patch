+// Copyright 2026 Ubadream
+// SPDX-License-Identifier: Apache-2.0
+
+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+#[test]
+fn remote_handoff_replaces_only_bound_identity_and_preserves_media() {
+    let binding = Binding {
+        thread_id: "task".to_string(),
+        source_message_id: "msg_latest".to_string(),
+        source_text_sha1: digest("repeated words"),
+        handoff_path: PathBuf::from("handoff.md"),
+        handoff_sha1: digest("handoff"),
+        continuation: Continuation::Continue,
+    };
+    let older: ResponseItem = serde_json::from_value(json!({
+        "type":"message", "role":"user", "id":"msg_older",
+        "content":[{"type":"input_text","text":"repeated words"}]
+    }))
+    .unwrap();
+    let latest: ResponseItem = serde_json::from_value(json!({
+        "type":"message", "role":"user", "id":"msg_latest",
+        "content":[{"type":"input_text","text":"repeated words"},
+            {"type":"input_image","image_url":"data:image/png;base64,aGVsbG8="}]
+    }))
+    .unwrap();
+    let mut items = vec![
+        ResponseItemEnvelope::new(older.clone()),
+        ResponseItemEnvelope::new(latest),
+    ];
+    remove_covered(&binding, &mut items);
+    assert_eq!(items[0].item, older);
+    if let ResponseItem::Message { content, .. } = &items[1].item {
+        assert_eq!(content.len(), 2);
+        assert!(
+            matches!(&content[0], ContentItem::InputText { text } if text == "Original request text is covered by the thread handoff; attachments are preserved.")
+        );
+        assert!(matches!(&content[1], ContentItem::InputImage { .. }));
+    } else {
+        panic!("media message must remain");
+    }
+    let mut old_only = vec![ResponseItemEnvelope::new(older.clone())];
+    remove_covered(&binding, &mut old_only);
+    assert_eq!(old_only[0].item, older);
+}
+
+#[test]
+fn handoff_read_rejects_empty_and_oversize_instead_of_truncating() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("handoff.md");
+    std::fs::write(&path, " ").unwrap();
+    assert!(read_bounded(&path).is_err());
+    std::fs::write(&path, "x".repeat(MAX_HANDOFF_BYTES as usize + 1)).unwrap();
+    assert!(read_bounded(&path).is_err());
+    std::fs::write(&path, "Synthetic request and continuation point").unwrap();
+    assert_eq!(read_bounded(&path).unwrap(), "Synthetic request and continuation point");
+}
