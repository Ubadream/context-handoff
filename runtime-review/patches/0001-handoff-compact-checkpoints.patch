+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_turn("Preserve source\n\nContinue this segment").await?;
+    let files: Vec<_> = std::fs::read_dir(test.codex_home_path().join("handoff-compact/originals"))?
+        .collect::<std::io::Result<_>>()?;
+    assert_eq!(files.len(), 1);
+    let archive = std::fs::read_to_string(files[0].path())?;
+    assert!(archive.contains("Final sentence  preserve whitespace"));
+    assert!(!archive.contains("NATIVE_SUMMARY"));
+    test.submit_turn("next turn").await?;
+    let requests = mock.requests();
+    assert_eq!(requests.len(), 4);
+    assert!(requests[3].body_contains_text("NATIVE_SUMMARY"));
+    let input = requests[3].body_json();
+    let notice = input["input"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .filter_map(|i| i.get("content").and_then(|c| c.as_array()))
+        .flatten()
+        .filter_map(|c| c.get("text").and_then(|s| s.as_str()))
+        .find(|s| s.contains("C compaction:"))
+        .expect("C pointer must reach next request");
+    let path = notice
+        .split("archived at ")
+        .nth(1)
+        .unwrap()
+        .split(". This is historical")
+        .next()
+        .unwrap();
+    assert_eq!(
