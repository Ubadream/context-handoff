+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[ignore = "prepared handoffs are disabled until atomic index publication is implemented"]
+async fn handoff_compact_bound_handoff_replaces_request_and_continues_once() -> Result<()> {
+    for mode in ["A", "C"] {
+        let dir = tempfile::tempdir()?;
+        let path = dir.path().join("HANDOFF.md");
+        std::fs::write(&path, "Synthetic request: fix wiring. Completed: saved. Next: build.")?;
+        let server = responses::start_mock_server().await;
+        let mock = responses::mount_sse_sequence(
+            &server,
+            vec![
+                prepare(&path, "continue"),
+                select("select", mode),
+                reply("final", "saved; compact now"),
+                reply("summary", "BOUND_SUMMARY"),
+                reply("continued", "build finished"),
+            ],
+        )
+        .await;
+        let test = test_codex()
+            .with_config(|c| c.model_provider.name = "OpenAI (test)".to_string())
+            .build(&server)
+            .await?;
+        test.submit_turn("OLD_REQUEST_DO_NOT_REPLAY_240K").await?;
+        let requests = mock.requests();
+        assert_eq!(
+            requests.len(),
+            5,
+            "continue must sample once after compaction without a new prompt"
+        );
+        assert!(!requests[4].body_contains_text("OLD_REQUEST_DO_NOT_REPLAY_240K"));
+        assert!(requests[4].body_contains_text("BOUND_SUMMARY"));
+        assert!(requests[4].body_contains_text("Read the handoff and continue only unfinished work already authorized by the user"));
+        let rollout = std::fs::read_to_string(test.codex.rollout_path().unwrap())?;
+        let checkpoint = rollout
+            .lines()
+            .map(serde_json::from_str::<serde_json::Value>)
+            .collect::<std::result::Result<Vec<_>, _>>()?
+            .into_iter()
+            .find(|r| r["type"] == "compacted")
+            .unwrap();
+        let replacement = checkpoint["payload"]["replacement_history"].to_string();
+        assert!(!replacement.contains("OLD_REQUEST_DO_NOT_REPLAY_240K"));
+        assert!(replacement.contains("Handoff"));
+        // The original source stays in the append-only rollout.
+        assert!(rollout.contains("OLD_REQUEST_DO_NOT_REPLAY_240K"));
+        let bindings: Vec<_> =
+            std::fs::read_dir(test.codex_home_path().join("handoff-compact/handoffs"))?
+                .collect::<std::io::Result<_>>()?;
+        assert_eq!(bindings.len(), 1);
+        let binding: serde_json::Value = serde_json::from_str(&std::fs::read_to_string(
+            bindings[0].path().join("binding.json"),
+        )?)?;
+        assert_eq!(
+            std::fs::read_to_string(binding["handoff_path"].as_str().unwrap())?,
