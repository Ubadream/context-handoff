+// Copyright 2026 Ubadream
+// SPDX-License-Identifier: Apache-2.0
+
+use super::session::Session;
+use super::turn_context::TurnContext;
+use crate::context::CheckpointReminder;
+use crate::context::ContextualUserFragment;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::SessionSource;
+
+/// Append at most one reminder per stage in this thread's active context window.
+/// History carries delivery across resume; compaction changes the window identity.
+pub(super) async fn maybe_record(sess: &Session, turn: &TurnContext) -> bool {
+    if !turn.config.context_checkpoint_reminders
+        || matches!(
+            turn.session_source,
+            SessionSource::SubAgent(_) | SessionSource::Internal(_)
+        )
+    {
+        return false;
+    }
+    // A final response with compaction already scheduled needs no extra model request.
+    let turn_state = {
+        let active = sess.active_turn.lock().await;
+        active
+            .as_ref()
+            .map(|active| std::sync::Arc::clone(&active.turn_state))
+    };
+    if let Some(state) = turn_state
+        && state.lock().await.handoff_compact.is_some()
+    {
+        return false;
+    }
+    let used = sess.get_total_token_usage().await;
+    let prepare_threshold = turn.config.context_checkpoint_prepare_tokens;
+    let compact_threshold = turn.config.context_checkpoint_compact_tokens;
+    let review_threshold = turn.config.context_checkpoint_review_tokens;
+    let thresholds = [
+        Some(compact_threshold),
+        Some(prepare_threshold),
+        review_threshold,
+    ];
+    let Some(threshold) = thresholds
+        .into_iter()
+        .flatten()
+        .find(|threshold| used >= *threshold)
+    else {
+        return false;
+    };
+    let window_id = sess
+        .state
+        .lock()
+        .await
+        .auto_compact_window_ids()
+        .window_id
+        .to_string();
+    let history = sess.clone_history().await;
+    if history.raw_items().any(|item| {
+        matches!(item, ResponseItem::Message { role, content, .. }
+        if role == "developer" && content.iter().any(|content| {
+            matches!(content, ContentItem::InputText { text }
+                if CheckpointReminder::matches_text(text)
+                    && thresholds.into_iter().flatten().any(|delivered_threshold| {
+                        delivered_threshold >= threshold && text.contains(
+                            &format!("window_id={window_id}; threshold={delivered_threshold}\n")
+                        )
+                    }))
+        }))
+    }) {
+        return false;
+    }
+    let item = ContextualUserFragment::into(CheckpointReminder {
+        window_id,
+        thread_id: sess.thread_id.to_string(),
+        used,
+        threshold,
+        compact_threshold,
+        review_threshold,
+    });
+    sess.record_conversation_items(turn, turn.model_info(), &[item])
+        .await;
+    true
+}
