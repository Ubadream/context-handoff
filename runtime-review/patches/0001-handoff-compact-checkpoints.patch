+
+fn reply(id: &str, text: &str) -> String {
+    sse(vec![ev_assistant_message(id, text), ev_completed(id)])
+}
+
+fn select(id: &str, mode: &str) -> String {
+    sse(vec![
+        ev_function_call(
+            id,
+            "handoff_compact",
+            &json!({"mode": mode, "reason":"finished work boundary"}).to_string(),
+        ),
+        ev_completed(id),
+    ])
+}
+
+fn prepare(path: &std::path::Path, continuation: &str) -> String {
+    sse(vec![
+        ev_function_call(
+            "prepare",
+            "handoff_compact",
+            &json!({
+                "mode": "prepare", "reason": "save this task's stopping point",
+                "handoff_path": path, "continuation": continuation,
+            })
+            .to_string(),
+        ),
+        ev_completed("prepare"),
+    ])
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[ignore = "prepared handoffs are disabled until atomic index publication is implemented"]
+// Local synthetic source fixtures are deliberate; remote selection has dedicated coverage.
+async fn handoff_compact_native_midturn_uses_prepared_handoff() -> Result<()> {
+    let dir = tempfile::tempdir()?;
