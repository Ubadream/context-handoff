+// Copyright 2026 Ubadream
+// SPDX-License-Identifier: Apache-2.0
+
+//! Turn-local compaction choices; history replacement stays in the native task.
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use serde::Deserialize;
+use serde::Serialize;
+use std::io::BufReader;
+use std::io::Seek;
+use std::io::SeekFrom;
+use std::io::Write;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub(crate) enum Mode {
+    A,
+    C,
+    #[serde(rename = "prepare")]
+    Prepare,
+    #[serde(rename = "cancel")]
+    Cancel,
+}
+
+pub(crate) async fn take(sess: &Session) -> Option<Mode> {
+    let turn_state = {
+        let active = sess.active_turn.lock().await;
+        Arc::clone(&active.as_ref()?.turn_state)
+    };
+    let mut state = turn_state.lock().await;
+    state.handoff_binding_resume = false;
+    state.handoff_compact.take()
+}
+
+pub(crate) async fn archive(sess: &Session, turn: &TurnContext) -> CodexResult<PathBuf> {
+    sess.flush_rollout().await?;
+    let source = sess
+        .hook_transcript_path()
+        .await
+        .ok_or_else(|| CodexErr::InvalidRequest("C requires a persisted transcript".to_string()))?;
+    let sid = sess.thread_id.to_string();
+    let directory = turn.config.codex_home.join("handoff-compact/originals");
+    codex_exec_server::ExecutorFileSystem::create_directory(
+        &codex_exec_server::LocalFileSystem::unsandboxed(),
+        &codex_utils_path_uri::PathUri::from_host_native_path(&directory)
+            .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?,
+        codex_exec_server::CreateDirectoryOptions {
+            recursive: true,
+            follow_symlinks: false,
+        },
+        /*sandbox*/ None,
+    ).await?;
+    let path = directory.join(format!("{}_{}.jsonl", sess.thread_id, uuid::Uuid::new_v4()));
+    tokio::task::spawn_blocking(move || {
+        export_originals(std::path::Path::new(&source), &sid, path.as_path())
+    })
+    .await
+    .map_err(|e| CodexErr::InvalidRequest(e.to_string()))?
+}
+
+// Unknown fields (tool outputs, encrypted reasoning and image bytes) are skipped by
+// serde rather than copied into a Value or loaded as an entire rollout-sized string.
+#[derive(Deserialize)]
+struct ArchiveRecord {
+    #[serde(rename = "type")]
+    kind: String,
+    payload: ArchivePayload,
+}
+
+#[derive(Deserialize)]
+struct ArchivePayload {
+    #[serde(rename = "type")]
+    kind: Option<String>,
+    id: Option<String>,
+    role: Option<String>,
+    channel: Option<String>,
+    content: Option<Vec<ArchiveText>>,
+    internal_chat_message_metadata_passthrough: Option<ArchiveMetadata>,
+}
+
+#[derive(Deserialize)]
+struct ArchiveMetadata {
+    content_item_kinds: Option<Vec<String>>,
+}
+
+#[derive(Deserialize)]
+struct ArchiveText {
+    #[serde(rename = "type")]
+    kind: String,
+    text: Option<String>,
+}
+
+fn export_originals(
+    source: &std::path::Path,
+    sid: &str,
+    path: &std::path::Path,
+) -> CodexResult<PathBuf> {
+    let mut records =
+        serde_json::Deserializer::from_reader(BufReader::new(
+            codex_exec_server::open_regular_file_no_follow(source)?,
+        ))
+            .into_iter::<ArchiveRecord>();
+    let header = records
+        .next()
+        .transpose()?
+        .ok_or_else(|| CodexErr::InvalidRequest("Empty transcript".to_string()))?;
+    if header.kind != "session_meta" || header.payload.id.as_deref() != Some(sid) {
+        return Err(CodexErr::InvalidRequest(
+            "Transcript identity mismatch".to_string(),
+        ));
+    }
+    // Never overwrite an existing archive or follow a link in its path.
+    // A failed export can leave an unreferenced partial file, never a checkpoint pointer.
+    let mut file = codex_exec_server::create_new_file_no_follow(path)?;
+    let mut messages = 0;
+    for record in records {
+        let record = record?;
+        if record.kind == "compacted" {
+            file.set_len(0)?;
+            file.seek(SeekFrom::Start(0))?;
+            messages = 0;
+        } else if record.kind == "response_item"
+            && record.payload.kind.as_deref() == Some("message")
+            && matches!(record.payload.role.as_deref(), Some("user" | "assistant"))
+            && record.payload.channel.as_deref() != Some("analysis")
+        {
+            let kinds = record
+                .payload
+                .internal_chat_message_metadata_passthrough
+                .and_then(|m| m.content_item_kinds)
+                .unwrap_or_default();
+            let texts: Vec<_> = record
+                .payload
+                .content
+                .unwrap_or_default()
+                .into_iter()
+                .enumerate()
+                .filter(|(i, _)| {
+                    !kinds.get(*i).is_some_and(|k| {
+                        matches!(k.as_str(), "compaction.summary" | "handoff_compact.notice")
+                            || (record.payload.role.as_deref() == Some("user")
+                                && !k.is_empty()
+                                && k != "unknown"
+                                && !k.starts_with("user."))
+                    })
+                })
+                .map(|(_, c)| c)
+                .filter(|c| matches!(c.kind.as_str(), "input_text" | "output_text"))
+                .filter(|c| {
+                    record.payload.role.as_deref() != Some("user")
+                        || !crate::context::is_contextual_user_fragment(
+                            &codex_protocol::models::ContentItem::InputText {
+                                text: c.text.clone().unwrap_or_default(),
+                            },
+                        )
+                })
+                .filter_map(|c| c.text)
+                .collect();
+            if !texts.is_empty() {
+                serde_json::to_writer(
+                    &mut file,
+                    &serde_json::json!({"id":record.payload.id,"role":record.payload.role,"text":texts}),
+                )?;
+                file.write_all(b"\n")?;
+                messages += 1;
+            }
+        }
+    }
+    if messages == 0 {
+        return Err(CodexErr::InvalidRequest(
+            "No visible dialogue after the last checkpoint".to_string(),
+        ));
+    }
+    file.sync_all()?;
+    Ok(path.to_path_buf())
+}
