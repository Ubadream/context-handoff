+    let server = responses::start_mock_server().await;
+    let high =
+        sse(vec![
+        ev_function_call("prepare", "handoff_compact", &json!({
+            "mode":"prepare", "reason":"ready", "handoff_path":path, "continuation":"continue",
+        }).to_string()),
+        responses::ev_completed_with_tokens("high", 330_000),
+    ]);
+    let mock = responses::mount_sse_sequence(
+        &server,
+        vec![
+            high,
