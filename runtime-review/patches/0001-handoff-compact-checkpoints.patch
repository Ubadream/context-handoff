+// Copyright 2026 Ubadream
+// SPDX-License-Identifier: Apache-2.0
+
+use codex_exec_server::GetMetadataOptions;
+use codex_tools::JsonSchema;
+use codex_tools::ResponsesApiTool;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use crate::function_tool::FunctionCallError;
+use crate::handoff_compact::Mode;
+use crate::tools::context::FunctionToolOutput;
+use crate::tools::context::ToolInvocation;
+use crate::tools::context::ToolPayload;
+use crate::tools::context::boxed_tool_output;
+use crate::tools::registry::CoreToolRuntime;
+use crate::tools::registry::ToolExecutor;
+use futures::StreamExt;
+use serde::Deserialize;
+use serde_json::json;
+use std::collections::BTreeMap;
+
+pub struct HandoffCompactHandler;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Arguments {
+    mode: Mode,
+    reason: String,
+    handoff_path: Option<String>,
+    environment_id: Option<String>,
+    continuation: Option<crate::handoff_binding::Continuation>,
+}
+
+impl ToolExecutor<ToolInvocation> for HandoffCompactHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("handoff_compact")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        ToolSpec::Function(ResponsesApiTool {
+            name: "handoff_compact".to_string(),
+            description: "Prepared handoffs, request binding, and automatic handoff continuation are disabled in this build; do not call prepare. A schedules native summarization after the final response. C also saves a local plaintext archive of visible dialogue text since the previous checkpoint. cancel cancels this turn's scheduled compaction. New input or cancellation cancels the schedule. Existing hooks still apply. A/C scheduling receipts are not completion; completion is reported by the contextCompaction event.".to_string(),
+            strict: false,
+            defer_loading: None,
+            parameters: JsonSchema::object(BTreeMap::from([
+                ("mode".to_string(), JsonSchema::string_enum(vec![json!("prepare"), json!("A"), json!("C"), json!("cancel")], None)),
+                ("reason".to_string(), JsonSchema::string(Some("Brief reason (1..500 characters).".to_string()))),
+                ("handoff_path".to_string(), JsonSchema::string(Some("For prepare: a read-back UTF-8 handoff, at most 32 KiB. Absolute or relative to the selected environment's working directory.".to_string()))),
+                ("environment_id".to_string(), JsonSchema::string(Some("For prepare: selected execution environment; omitted uses the primary environment. Existing filesystem permissions are enforced without escalation.".to_string()))),
+                ("continuation".to_string(), JsonSchema::string_enum(vec![json!("continue"), json!("wait")], Some("For prepare: continue only unfinished authorized work; wait if complete or awaiting a decision.".to_string()))),
+            ]), Some(vec!["mode".to_string(), "reason".to_string()]), Some(false.into())),
+            output_schema: None,
+        })
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            let ToolPayload::Function { arguments } = invocation.payload else {
+                return Err(FunctionCallError::RespondToModel(
+                    "Expected function arguments".to_string(),
+                ));
+            };
+            let args: Arguments = super::parse_arguments(&arguments)?;
+            if args.reason.trim().is_empty() || args.reason.chars().count() > 500 {
+                return Err(FunctionCallError::RespondToModel(
+                    "reason must contain 1..500 characters".to_string(),
+                ));
+            }
+            let turn_state = {
+                let active = invocation.session.active_turn.lock().await;
+                let active = active.as_ref().ok_or_else(|| {
+                    FunctionCallError::RespondToModel("No active turn".to_string())
+                })?;
+                if invocation.cancellation_token.is_cancelled()
+                    || active
+                        .task
+                        .as_ref()
+                        .is_none_or(|task| task.turn_context.sub_id != invocation.turn.sub_id)
+                {
+                    return Err(FunctionCallError::RespondToModel(
+                        "The requesting turn is no longer active".to_string(),
+                    ));
+                }
+                std::sync::Arc::clone(&active.turn_state)
+            };
+            if args.mode == Mode::Prepare {
+                // Fail before reading the selected source or touching runtime storage.
+                crate::handoff_binding::ensure_storage_available().map_err(|error| {
+                    FunctionCallError::RespondToModel(error.to_string())
+                })?;
+                let path = args.handoff_path.ok_or_else(|| {
+                    FunctionCallError::RespondToModel("prepare requires handoff_path".to_string())
+                })?;
+                let continuation = args.continuation.ok_or_else(|| {
+                    FunctionCallError::RespondToModel("prepare requires continuation".to_string())
+                })?;
+                let environment = super::resolve_tool_environment(
+                    &invocation.step_context.environments,
+                    args.environment_id.as_deref(),
+                )?
+                .ok_or_else(|| {
+                    FunctionCallError::RespondToModel(
+                        "handoff prepare requires an execution environment".to_string(),
+                    )
+                })?;
+                // Resolve paths using the executor's path convention, never the host OS.
+                let path_uri = environment.cwd().join(&path).map_err(|error| {
+                    FunctionCallError::RespondToModel(format!(
+                        "unable to resolve handoff path: {error}"
+                    ))
+                })?;
+                let sandbox = environment.sandbox_context(/*additional_permissions*/ None);
+                let fs = environment.environment.get_filesystem();
+                let metadata = fs
+                    .get_metadata(&path_uri, GetMetadataOptions::default(), Some(&sandbox))
+                    .await
+                    .map_err(|error| {
+                        FunctionCallError::RespondToModel(format!(
+                            "unable to locate handoff through filesystem policy: {error}"
+                        ))
+                    })?;
+                if !metadata.is_file || metadata.size > crate::handoff_binding::MAX_HANDOFF_BYTES {
+                    return Err(FunctionCallError::RespondToModel(
+                        "handoff must be a regular file of at most 32 KiB".to_string(),
+                    ));
+                }
+                // Streaming keeps the accumulated text bounded even if the source grows
+                // after metadata inspection. The executor bounds each delivered chunk.
+                let mut stream = fs
+                    .read_file_stream(&path_uri, Some(&sandbox))
+                    .await
+                    .map_err(|error| {
+                        FunctionCallError::RespondToModel(format!(
+                            "unable to read handoff through filesystem policy: {error}"
+                        ))
+                    })?;
+                let mut bytes = Vec::new();
+                while let Some(chunk) = stream.next().await {
+                    if invocation.cancellation_token.is_cancelled() {
+                        return Err(FunctionCallError::RespondToModel(
+                            "handoff read cancelled".to_string(),
+                        ));
+                    }
+                    let chunk = chunk.map_err(|error| {
+                        FunctionCallError::RespondToModel(format!(
+                            "unable to stream handoff through filesystem policy: {error}"
+                        ))
+                    })?;
+                    if chunk.len() > (crate::handoff_binding::MAX_HANDOFF_BYTES as usize)
+                        .saturating_sub(bytes.len())
+                    {
+                        return Err(FunctionCallError::RespondToModel(
+                            "handoff exceeds 32 KiB".to_string(),
+                        ));
+                    }
+                    bytes.extend_from_slice(&chunk);
+                }
+                let text = String::from_utf8(bytes).map_err(|error| {
+                    FunctionCallError::RespondToModel(format!(
+                        "handoff is not valid UTF-8: {error}"
+                    ))
+                })?;
+                let binding = crate::handoff_binding::prepare(
+                    &invocation.session,
+                    &invocation.turn,
+                    &text,
+                    continuation,
+                )
+                .await
+                .map_err(|e| FunctionCallError::RespondToModel(format!("Handoff was not bound: {e}")))?;
+                return Ok(boxed_tool_output(FunctionToolOutput::from_text(
+                    json!({"prepared": binding, "compaction_started": false}).to_string(),
+                    Some(true),
+                )));
+            }
+            if args.handoff_path.is_some()
+                || args.continuation.is_some()
+                || args.environment_id.is_some()
+            {
+                return Err(FunctionCallError::RespondToModel(
+                    "handoff_path, environment_id and continuation are only valid for prepare".to_string(),
+                ));
+            }
+            let mut state = turn_state.lock().await;
+            state.handoff_compact = match args.mode {
+                Mode::Cancel => None,
+                mode => Some(mode),
+            };
+            Ok(boxed_tool_output(FunctionToolOutput::from_text(
+                json!({"scheduled": state.handoff_compact, "compaction_started": false, "turn_id": invocation.turn.sub_id}).to_string(),
+                Some(true),
+            )))
+        })
+    }
+}
+
+impl CoreToolRuntime for HandoffCompactHandler {}
