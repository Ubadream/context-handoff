+fn reply(id: &str, used: i64) -> String {
+    sse(vec![
+        ev_assistant_message(id, "done"),
+        ev_completed_with_tokens(id, used),
+    ])
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn checkpoint_reminder_custom_thresholds_replace_old_stages_and_survive_resume() -> Result<()>
+{
+    let server = responses::start_mock_server().await;
+    let mock = responses::mount_sse_sequence(
+        &server,
+        vec![
+            reply("below-new-review", 260_000),
+            reply("review", 265_000),
+            reply("review-ack", 265_000),
+            reply("prepare", 350_000),
+            reply("prepare-ack", 350_000),
+            reply("compact", 430_000),
+            reply("compact-ack", 265_000),
+            reply("resumed", 265_000),
+        ],
+    )
+    .await;
+    let configure = |c: &mut codex_core::config::Config| {
+        c.context_checkpoint_reminders = true;
+        c.context_checkpoint_review_tokens = Some(265_000);
+        c.context_checkpoint_prepare_tokens = 350_000;
+        c.context_checkpoint_compact_tokens = 430_000;
+        c.model_context_window = Some(500_000);
+        c.model_auto_compact_token_limit = Some(450_000);
+    };
+    // The default fixture's max_context_window is below these checkpoints.
+    // Keep the production max-window clamp; give this test a large-window model.
+    let test = test_codex()
+        .with_config(configure)
+        .with_model_info_override("test-gpt-5.1-codex", |model| {
+            model.max_context_window = Some(500_000);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_turn("below new stages").await?;
+    test.submit_turn("review").await?;
+    test.submit_turn("prepare").await?;
+    test.submit_turn("compact").await?;
+    let path = test.codex.rollout_path().expect("rollout");
+    let home = test.home.clone();
+    test.codex.shutdown_and_wait().await?;
+    let resumed = test_codex()
+        .with_config(configure)
+        .with_model_info_override("test-gpt-5.1-codex", |model| {
+            model.max_context_window = Some(500_000);
+        })
+        .resume(&server, home, path)
+        .await?;
+    resumed.submit_turn("resume").await?;
+    let requests = mock.requests();
+    assert_eq!(
+        requests.len(),
+        8,
+        "delivered checkpoints by request: {:?}",
+        requests
+            .iter()
+            .map(|request| {
+                [265_000, 350_000, 430_000]
+                    .map(|threshold| request.body_contains_text(&format!("threshold={threshold}")))
+            })
+            .collect::<Vec<_>>()
+    );
+    assert!(!requests[1].body_contains_text("<context_checkpoint_reminder>"));
+    assert!(requests[2].body_contains_text("threshold=265000"));
+    assert!(requests[2].body_contains_text("Review task completion"));
+    assert!(requests[2].body_contains_text("are not complete"));
+    assert!(requests[2].body_contains_text("Follow the handoff steps only"));
+    assert!(requests[4].body_contains_text("threshold=350000"));
+    assert!(requests[4].body_contains_text("exceed 430000 tokens"));
+    assert!(requests[6].body_contains_text("threshold=430000"));
+    assert!(requests[6].body_contains_text("Reached 430000 tokens"));
+    let last = requests[7].body_json().to_string();
+    assert_eq!(last.matches("<context_checkpoint_reminder>").count(), 3);
+    assert!(!last.contains("threshold=240000"));
+    Ok(())
+}
