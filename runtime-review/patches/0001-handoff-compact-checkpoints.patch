+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+#[test]
+fn archive_exports_only_current_segment_and_rejects_wrong_session() {
+    let dir = tempfile::tempdir().unwrap();
+    let source = dir.path().join("rollout.jsonl");
+    let target = dir.path().join("originals.jsonl");
+    let records = [
+        json!({"type":"session_meta","payload":{"id":"same-session"}}),
+        json!({"type":"response_item","payload":{"type":"message","role":"user","content":[{"type":"input_text","text":"old words"}]}}),
+        json!({"type":"compacted","payload":{"message":"old summary","replacement_history":[]}}),
+        json!({"type":"response_item","payload":{"type":"message","role":"user","content":[{"type":"input_text","text":"injected host context"}],"internal_chat_message_metadata_passthrough":{"content_item_kinds":["context.host"]}}}),
+        json!({"type":"response_item","payload":{"type":"message","role":"user","content":[{"type":"input_text","text":"<handoff_compact_history>old pointer</handoff_compact_history>"}]}}),
+        json!({"type":"response_item","payload":{"type":"function_call_output","output":"x".repeat(1024*1024)}}),
+        json!({"type":"response_item","payload":{"type":"message","role":"user","content":[{"type":"input_text","text":"Current\n  literal words"},{"type":"input_image","image_url":"base64-do-not-export"}]}}),
+        json!({"type":"response_item","payload":{"type":"message","role":"assistant","content":[{"type":"output_text","text":"Final response"}]}}),
+    ];
+    std::fs::write(
+        &source,
+        records.iter().map(|r| format!("{r}\n")).collect::<String>(),
+    )
+    .unwrap();
+    assert!(export_originals(&source, "wrong-session", &target).is_err());
+    assert!(!target.exists());
+    export_originals(&source, "same-session", &target).unwrap();
+    let rows: Vec<serde_json::Value> = std::fs::read_to_string(&target)
+        .unwrap()
+        .lines()
+        .map(|l| serde_json::from_str(l).unwrap())
+        .collect();
+    assert_eq!(
+        rows,
+        vec![
+            json!({"id":null,"role":"user","text":["Current\n  literal words"]}),
+            json!({"id":null,"role":"assistant","text":["Final response"]})
+        ]
+    );
+}
